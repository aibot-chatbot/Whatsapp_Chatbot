---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Publish your bot | Omnexa" adminOnly>
    <Fragment slot="head">
    <link rel="stylesheet" href="assets/css/publish.css">
    <link rel="stylesheet" href="assets/css/bot-setup-journey.css">
    <script is:inline src="assets/js/bot-setup-journey.js" defer></script>
    <link rel="stylesheet" href="assets/css/product-tour.css">
    <script is:inline src="assets/js/product-tour.js" defer></script>
    <script is:inline src="assets/js/qrcode-gen.js" defer></script>
    </Fragment>

    <main class="main-container kw-page pub-page">
        <bot-setup-journey current="publish"></bot-setup-journey>
        <header class="kw-header cr-reveal">
            <div>
                <h1>Publish your bot</h1>
                <p class="kw-header-sub">
                    Choose where customers can chat with your bot. Connect a channel when you are ready.
                </p>
                <p class="kw-help" role="status" aria-live="polite" id="pub-status">
                    <span class="cr-live-dot is-idle" id="pub-live-dot" aria-hidden="true"></span>
                    <span id="pub-status-text">Checking your connections…</span>
                </p>
            </div>
            <div class="kw-header-aside">
                <div class="kw-readiness">
                    <p class="kw-readiness-title">Ways to reach you</p>
                    <div class="kw-readiness-figures">
                        <div class="kw-figure">
                            <strong class="kw-mono cr-swap" id="pub-live-count">-</strong>
                            <span>Connected</span>
                        </div>
                        <div class="kw-figure">
                            <strong class="kw-mono" id="pub-slots">-</strong>
                            <span>Plan channels</span>
                        </div>
                    </div>
                    <p class="kw-readiness-foot">Website and share link do not use a channel slot.</p>
                </div>
                <button type="button" class="kw-btn cr-press" id="pub-recheck">
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 4v5h-5"/></svg>
                    Check again
                </button>
            </div>
        </header>

        <section class="kw-panel cr-reveal" id="pub-add" aria-labelledby="pub-add-title">
            <div class="kw-panel-head">
                <h2 class="kw-panel-title" id="pub-add-title">
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                    Choose a channel
                </h2>
                <span class="kw-help" id="pub-slot-note"></span>
            </div>
            <div class="kw-panel-body">
                <p class="kw-help pub-choice-help">Choose one to see its setup steps. You can connect more channels later.</p>
                <div class="pub-list" id="pub-options">
                    <div class="cr-skeleton pub-skeleton-xl"></div>
                </div>
            </div>
        </section>

        <section class="kw-panel cr-reveal" id="pub-live" aria-labelledby="pub-live-title">
            <div class="kw-panel-head">
                <h2 class="kw-panel-title" id="pub-live-title">Your connections</h2>
                <span class="kw-help">Connection status and latest checks</span>
            </div>
            <div class="kw-panel-body" id="pub-live-body">
                <div class="cr-skeleton pub-skeleton-lg"></div>
            </div>
        </section>

        <!-- Nothing below is needed to publish, so all of it starts closed. -->
        <div class="pub-settings cr-reveal" id="pub-settings">
            <details class="kw-advanced" id="pub-look">
                <summary>
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18h1.5a2.5 2.5 0 0 0 0-5H13a2 2 0 0 1 0-4h4a4 4 0 0 0 4-4 5 5 0 0 0-5-5Z"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="12" cy="7.5" r="1"/></svg>
                    Change how the chat looks
                    <svg class="dashboard-icon kw-advanced-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="kw-advanced-body">
                    <div class="kw-field">
                        <label class="kw-label" for="ww-display_name">Chat title</label>
                        <input class="kw-input" id="ww-display_name" type="text" maxlength="80">
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-subtitle">Line under the title</label>
                        <input class="kw-input" id="ww-subtitle" type="text" maxlength="120">
                    </div>
                    <div class="kw-field kw-wide">
                        <label class="kw-label" for="ww-welcome_message">First message</label>
                        <textarea class="kw-textarea" id="ww-welcome_message" rows="2" maxlength="1000"></textarea>
                        <p class="kw-help">What your bot says before anyone types.</p>
                    </div>
                    <div class="kw-field kw-wide">
                        <label class="kw-label" for="ww-suggested_questions">Suggested questions</label>
                        <textarea class="kw-textarea" id="ww-suggested_questions" rows="3"></textarea>
                        <p class="kw-help">One per line, up to 4. People tap these instead of typing.</p>
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-primary_color">Main colour</label>
                        <input class="kw-input" id="ww-primary_color" type="color">
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-text_color">Colour of the writing on it</label>
                        <input class="kw-input" id="ww-text_color" type="color">
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-avatar_url">Picture</label>
                        <input class="kw-input" id="ww-avatar_url" type="url" maxlength="500" placeholder="https://">
                        <p class="kw-help">A web address for a small round picture. Leave empty for none.</p>
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-input_placeholder">What the box says before they type</label>
                        <input class="kw-input" id="ww-input_placeholder" type="text" maxlength="120">
                    </div>
                    <div class="pub-save">
                        <button type="button" class="kw-btn kw-btn-primary cr-press" data-save="look">Save changes</button>
                        <span class="kw-help" role="status" aria-live="polite" data-savestate="look"></span>
                    </div>
                </div>
            </details>

            <details class="kw-advanced" id="pub-lead">
                <summary>
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg>
                    Ask for contact details first
                    <svg class="dashboard-icon kw-advanced-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="kw-advanced-body">
                    <div class="kw-field kw-wide">
                        <label class="kw-check" for="ww-collect_lead">
                            <input type="checkbox" id="ww-collect_lead">
                            Ask for details before the chat starts
                        </label>
                        <p class="kw-help">Off by default. Asking first turns some people away.</p>
                    </div>
                    <div class="kw-field kw-wide pub-dependent" data-depends="ww-collect_lead" hidden>
                        <label class="kw-label" for="ww-lead_prompt">What to say when you ask</label>
                        <textarea class="kw-textarea" id="ww-lead_prompt" rows="2" maxlength="300"></textarea>
                    </div>
                    <div class="kw-field pub-dependent" data-depends="ww-collect_lead" hidden>
                        <label class="kw-check" for="ww-lead_require_name">
                            <input type="checkbox" id="ww-lead_require_name"> Ask for their name
                        </label>
                    </div>
                    <div class="kw-field pub-dependent" data-depends="ww-collect_lead" hidden>
                        <label class="kw-check" for="ww-lead_require_email">
                            <input type="checkbox" id="ww-lead_require_email"> Ask for their email
                        </label>
                    </div>
                    <div class="kw-field pub-dependent" data-depends="ww-collect_lead" hidden>
                        <label class="kw-check" for="ww-lead_require_phone">
                            <input type="checkbox" id="ww-lead_require_phone"> Ask for their phone number
                        </label>
                    </div>
                    <div class="pub-save">
                        <button type="button" class="kw-btn kw-btn-primary cr-press" data-save="lead">Save changes</button>
                        <span class="kw-help" role="status" aria-live="polite" data-savestate="lead"></span>
                    </div>
                </div>
            </details>

            <details class="kw-advanced" id="pub-adv">
                <summary>
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
                    Advanced
                    <svg class="dashboard-icon kw-advanced-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </summary>
                <div class="kw-advanced-body">
                    <div class="kw-field kw-wide">
                        <label class="kw-label" for="ww-allowed_domains">Websites allowed to show this chat</label>
                        <textarea class="kw-textarea" id="ww-allowed_domains" rows="3"></textarea>
                        <p class="kw-help">One per line. Leave empty to allow any website.</p>
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-max_messages_per_session">Most messages one visitor can send</label>
                        <input class="kw-input" id="ww-max_messages_per_session" type="number" min="1" max="500">
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-launcher_position">Which corner the bubble sits in</label>
                        <select class="kw-select" id="ww-launcher_position">
                            <option value="right">Right</option>
                            <option value="left">Left</option>
                        </select>
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-launcher_label">Words on the bubble</label>
                        <input class="kw-input" id="ww-launcher_label" type="text" maxlength="40">
                    </div>
                    <div class="kw-field">
                        <label class="kw-check" for="ww-show_branding">
                            <input type="checkbox" id="ww-show_branding"> Show our name at the bottom
                        </label>
                    </div>
                    <div class="kw-field">
                        <label class="kw-label" for="ww-branding_text">What that line says</label>
                        <input class="kw-input" id="ww-branding_text" type="text" maxlength="60">
                    </div>
                    <div class="pub-save">
                        <button type="button" class="kw-btn kw-btn-primary cr-press" data-save="adv">Save changes</button>
                        <span class="kw-help" role="status" aria-live="polite" data-savestate="adv"></span>
                    </div>
                    <div class="kw-locked kw-wide">
                        <span class="kw-locked-icon" aria-hidden="true">
                            <svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
                        </span>
                        <div>
                            <h4>Make a new link</h4>
                            <p>This makes a brand new link straight away and stops the old one working. Anything you already printed, posted or sent stops working.</p>
                        </div>
                        <div class="kw-locked-actions">
                            <button type="button" class="kw-btn kw-btn-danger cr-press" id="pub-regenerate">Make a new link</button>
                        </div>
                    </div>
                </div>
            </details>
        </div>
    </main>

    <!-- Modals survive only for things that cannot be undone. Setup is inline. -->
    <div class="kw-backdrop" id="pub-confirm">
        <div class="kw-modal kw-modal-narrow" role="dialog" aria-modal="true" aria-labelledby="pub-confirm-title">
            <div class="kw-modal-head">
                <h3 id="pub-confirm-title">Are you sure?</h3>
            </div>
            <div class="kw-modal-body">
                <p id="pub-confirm-body"></p>
            </div>
            <div class="kw-modal-foot">
                <button type="button" class="kw-btn cr-press" id="pub-confirm-cancel">Keep it</button>
                <button type="button" class="kw-btn kw-btn-danger cr-press" id="pub-confirm-ok">Confirm</button>
            </div>
        </div>
    </div>

    <p class="kw-visually-hidden" role="status" aria-live="polite" id="pub-announce"></p>

    <Fragment slot="end">
    <script is:inline src="assets/js/integration.js"></script>
    </Fragment>
</AppLayout>
