---
// Profile on the shared tenant frame (F4), moved like-for-like from frontend/profile.html.
// AppLayout supplies theme-boot.js and require-login.js; profile.js keeps all account logic.
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Profile | Omnexa">
    <Fragment slot="head">
    <link rel="stylesheet" href="assets/css/profile.css">
    </Fragment>

    <main class="main-container kw-page">
        <header class="kw-header">
            <div>
                <h1>Profile</h1>
                <p class="kw-header-sub">Your account, your security, and where you stand in this workspace.</p>
            </div>
            <!-- Nothing interactive belongs in this right slot: a fixed
                 account menu at z-index 1001 sits over it and swallows
                 clicks. Every action on this page lives in a panel. -->
        </header>

        <div class="kw-banner kw-banner-error" id="pro-error" hidden>
            <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
            </svg>
            <span id="pro-error-text"></span>
            <button type="button" class="kw-btn cr-press" id="pro-retry" style="margin-left:auto">Try again</button>
        </div>

        <!-- ── 1. Identity hero ──────────────────────────────────────────
             The one composition no other control-room page has. Skeleton
             holds the exact final box so nothing jumps when /api/user
             lands, which keeps CLS at zero. -->
        <div class="pro-hero pro-hero-skeleton" id="pro-hero-skeleton">
            <div class="cr-skeleton pro-skeleton-avatar"></div>
            <div class="pro-hero-ident">
                <div class="cr-skeleton pro-skeleton-line" style="width:34%"></div>
                <div class="cr-skeleton pro-skeleton-line is-tall" style="width:56%"></div>
                <div class="cr-skeleton pro-skeleton-line" style="width:44%"></div>
            </div>
            <div class="cr-skeleton pro-skeleton-gauge"></div>
        </div>

        <section class="pro-hero cr-reveal" id="pro-hero" aria-labelledby="pro-hero-name" hidden>
            <div class="pro-avatar" id="pro-avatar" aria-hidden="true"></div>

            <div class="pro-hero-ident">
                <p class="pro-eyebrow">Signed in as</p>
                <h2 class="pro-name" id="pro-hero-name"></h2>
                <p class="pro-email" id="pro-hero-email"></p>
                <div class="pro-hero-tags" id="pro-hero-tags"></div>
                <p class="pro-tenure" id="pro-hero-tenure"></p>
            </div>

            <div class="pro-hero-gauge" id="pro-hero-gauge"></div>
        </section>

        <!-- ── 2. Security ───────────────────────────────────────────── -->
        <section class="kw-panel cr-reveal" aria-labelledby="pro-security-title">
            <div class="kw-panel-head">
                <div>
                    <h2 class="kw-panel-title" id="pro-security-title">Security posture</h2>
                    <p class="kw-help">The signals behind the score above. Each one you complete raises it.</p>
                </div>
            </div>

            <div id="pro-signals-loading">
                <div class="cr-skeleton pro-skeleton-signal"></div>
                <div class="cr-skeleton pro-skeleton-signal"></div>
                <div class="cr-skeleton pro-skeleton-signal"></div>
                <div class="cr-skeleton pro-skeleton-signal"></div>
            </div>

            <div class="kw-empty" id="pro-signals-empty" hidden>
                <span class="kw-empty-icon" aria-hidden="true">
                    <svg class="dashboard-icon" viewBox="0 0 24 24">
                        <path d="M12 3 4 6v6c0 5 3.4 8.6 8 9.7 4.6-1.1 8-4.7 8-9.7V6z" />
                    </svg>
                </span>
                <h3>Security signals unavailable</h3>
                <p>We could not read your account details, so there is nothing to score yet.</p>
            </div>

            <ul class="pro-signals" id="pro-signals" hidden></ul>
        </section>

        <section class="kw-panel cr-reveal" aria-labelledby="pro-password-title">
            <div class="kw-panel-head">
                <div>
                    <h2 class="kw-panel-title" id="pro-password-title">Change password</h2>
                    <p class="kw-help">You stay signed in on this device after the change.</p>
                </div>
            </div>

            <form class="kw-panel-body pro-form" id="pro-password-form" novalidate>
                <div class="kw-banner" id="pro-password-msg" hidden>
                    <span id="pro-password-msg-text"></span>
                </div>

                <!-- Kept as flat siblings: kw-field spacing is adjacency-only
                     (.kw-field + .kw-field), so a wrapper between these would
                     silently remove the gap. -->
                <div class="kw-field">
                    <label class="kw-label" for="profile-current-password">Current password</label>
                    <div class="pro-secret">
                        <input class="kw-input" type="password" id="profile-current-password"
                               name="current_password" autocomplete="current-password" spellcheck="false">
                        <button type="button" class="kw-iconbtn cr-press pro-secret-toggle"
                                data-secret="profile-current-password" aria-pressed="false"
                                aria-label="Show current password"></button>
                    </div>
                </div>

                <div class="kw-field">
                    <label class="kw-label" for="profile-new-password">New password</label>
                    <div class="pro-secret">
                        <input class="kw-input" type="password" id="profile-new-password"
                               name="new_password" autocomplete="new-password" spellcheck="false"
                               aria-describedby="pro-strength-text pro-rules">
                        <button type="button" class="kw-iconbtn cr-press pro-secret-toggle"
                                data-secret="profile-new-password" aria-pressed="false"
                                aria-label="Show new password"></button>
                    </div>

                    <div class="pro-strength">
                        <!-- The bar is decoration for the word beside it: the
                             strength is never signalled by colour alone. -->
                        <div class="kw-progress" aria-hidden="true">
                            <div class="kw-progress-fill" id="pro-strength-fill"></div>
                        </div>
                        <p class="pro-strength-text" id="pro-strength-text" role="status" aria-live="polite"></p>
                    </div>

                    <p class="kw-help" id="pro-rules">At least 8 characters, with one uppercase letter, one number and one
                        special character.</p>
                </div>

                <div class="kw-field">
                    <label class="kw-label" for="profile-confirm-password">Confirm new password</label>
                    <div class="pro-secret">
                        <input class="kw-input" type="password" id="profile-confirm-password"
                               name="confirm_password" autocomplete="new-password" spellcheck="false">
                        <button type="button" class="kw-iconbtn cr-press pro-secret-toggle"
                                data-secret="profile-confirm-password" aria-pressed="false"
                                aria-label="Show confirmed password"></button>
                    </div>
                </div>

                <div class="pro-formfoot">
                    <button type="submit" class="kw-btn kw-btn-primary cr-press" id="pro-password-submit">
                        Update password
                    </button>
                </div>
            </form>
        </section>

        <!-- ── 3. Basic information ──────────────────────────────────── -->
        <section class="kw-panel cr-reveal" aria-labelledby="pro-account-title">
            <div class="kw-panel-head">
                <div>
                    <h2 class="kw-panel-title" id="pro-account-title">Basic information</h2>
                    <p class="kw-help">How you appear to everyone else in this workspace.</p>
                </div>
            </div>

            <form class="kw-panel-body pro-form" id="pro-account-form" novalidate>
                <div class="kw-banner" id="pro-account-msg" hidden>
                    <span id="pro-account-msg-text"></span>
                </div>

                <div class="kw-field">
                    <label class="kw-label" for="profile-full-name">Full name</label>
                    <input class="kw-input" type="text" id="profile-full-name" name="full_name"
                           autocomplete="name" maxlength="120" placeholder="Your name">
                </div>

                <div class="kw-field">
                    <label class="kw-label" for="profile-email">Email address</label>
                    <input class="kw-input" type="email" id="profile-email" name="email"
                           readonly aria-describedby="pro-email-note">
                    <p class="kw-help" id="pro-email-note">This is the address you sign in with. Ask an admin to change it.
                    </p>
                </div>

                <div class="kw-field">
                    <label class="kw-label" for="profile-phone">Phone number</label>
                    <input class="kw-input" type="tel" id="profile-phone" name="phone"
                           autocomplete="tel" inputmode="tel" maxlength="32"
                           placeholder="+60 12 345 6789" aria-describedby="pro-phone-note">
                    <p class="kw-help" id="pro-phone-note">Used to recover your account, and to reach you about CHIP
                        top-ups.</p>
                </div>

                <div class="pro-formfoot">
                    <button type="submit" class="kw-btn kw-btn-primary cr-press" id="pro-account-submit">
                        Save changes
                    </button>
                </div>
            </form>
        </section>

        <!-- ── 4. Standing in this workspace (read-only) ─────────────── -->
        <section class="kw-panel cr-reveal" aria-labelledby="pro-standing-title">
            <div class="kw-panel-head">
                <div>
                    <h2 class="kw-panel-title" id="pro-standing-title">Your standing in this workspace</h2>
                    <p class="kw-help">Read-only. Roles, invitations and removals are all handled on the Team page.</p>
                </div>
            </div>

            <div class="kw-panel-body" id="pro-standing-loading">
                <div class="cr-skeleton pro-skeleton-line is-tall" style="width:30%"></div>
                <div class="cr-skeleton pro-skeleton-block"></div>
                <div class="cr-skeleton pro-skeleton-block"></div>
            </div>

            <div class="kw-banner kw-banner-error pro-inline-banner" id="pro-standing-error" hidden>
                <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
                </svg>
                <span id="pro-standing-error-text"></span>
                <button type="button" class="kw-btn cr-press" id="pro-standing-retry"
                        style="margin-left:auto">Reload</button>
            </div>

            <div class="kw-empty" id="pro-standing-empty" hidden>
                <span class="kw-empty-icon" aria-hidden="true">
                    <svg class="dashboard-icon" viewBox="0 0 24 24">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8z" />
                    </svg>
                </span>
                <h3>No workspace roster yet</h3>
                <p>Once colleagues join, you will see how this workspace is made up.</p>
            </div>

            <div class="kw-panel-body pro-standing" id="pro-standing" hidden>
                <div class="pro-standing-lede">
                    <p class="kw-label">Your role</p>
                    <div class="pro-role-line" id="pro-role"></div>
                </div>

                <div class="pro-block">
                    <p class="kw-subhead">Your account timeline</p>
                    <ol class="kw-steps pro-steps" id="pro-timeline"></ol>
                </div>

                <div class="pro-block" id="pro-seats-block" hidden>
                    <p class="kw-subhead">Seats on this plan</p>
                    <div class="pro-seats" id="pro-seats"></div>
                </div>

                <div class="pro-block">
                    <p class="kw-subhead">Who is in this workspace</p>
                    <div class="kw-composition" id="pro-composition"></div>
                </div>

                <div class="pro-standing-foot">
                    <p class="kw-help" id="pro-pending"></p>
                    <a class="kw-btn cr-press" href="team.html" id="pro-team-link">Go to the Team page</a>
                </div>
            </div>
        </section>

        <!-- ── 5. Preferences ────────────────────────────────────────── -->
        <section class="kw-panel cr-reveal" aria-labelledby="pro-prefs-title">
            <div class="kw-panel-head">
                <div>
                    <h2 class="kw-panel-title" id="pro-prefs-title">Preferences</h2>
                    <p class="kw-help">Saved in this browser only.</p>
                </div>
            </div>

            <div class="kw-panel-body">
                <div class="kw-checklist pro-prefs">
                    <div class="kw-check">
                        <input type="checkbox" id="pref-notifications">
                        <label for="pref-notifications">Show browser notifications for new messages and follow-ups</label>
                    </div>
                </div>
                <p class="kw-help pro-prefs-note">This preference lives in this browser. It does not follow you to another
                    device, another browser, or a private window.</p>
            </div>
        </section>

        <!-- ── 6. Delete workspace ───────────────────────────────────────
             Exactly one of the four regions below is visible at a time; which
             one is decided by deletionView() in profile.js from what the
             server says. Only the eligible region has a button that starts
             the deletion, so the other people never see a control to press. -->
        <section class="kw-panel pro-delete cr-reveal" aria-labelledby="pro-delete-title">
            <div class="kw-panel-head">
                <div>
                    <h2 class="kw-panel-title" id="pro-delete-title">Delete workspace</h2>
                    <p class="kw-help">Permanently delete this workspace and everything in it. This cannot be undone.</p>
                </div>
            </div>

            <div class="kw-panel-body" id="pro-delete-loading">
                <div class="cr-skeleton pro-skeleton-line is-tall" style="width:40%"></div>
                <div class="cr-skeleton pro-skeleton-block"></div>
            </div>

            <div class="kw-banner kw-banner-error pro-inline-banner" id="pro-delete-error" hidden>
                <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24">
                    <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
                </svg>
                <span id="pro-delete-error-text"></span>
                <button type="button" class="kw-btn cr-press" id="pro-delete-retry"
                        style="margin-left:auto">Try again</button>
            </div>

            <div class="kw-panel-body" id="pro-delete-owner-only" hidden>
                <p class="pro-delete-text">Only the workspace owner can delete this workspace. If this workspace should be
                    closed, ask the owner to do it from their Profile page.</p>
            </div>

            <div class="kw-panel-body pro-delete-body" id="pro-delete-blocked" hidden>
                <p class="pro-delete-text" id="pro-delete-blocked-text"></p>
                <a class="kw-btn cr-press" id="pro-delete-support-link" href="support.html">Contact support</a>
            </div>

            <div class="kw-panel-body pro-delete-body" id="pro-delete-eligible" hidden>
                <div class="kw-banner" id="pro-delete-msg" hidden>
                    <span id="pro-delete-msg-text"></span>
                </div>
                <p class="pro-delete-text">Deleting <strong id="pro-delete-company">this workspace</strong> permanently removes:</p>
                <ul class="pro-delete-list">
                    <li>All chatbots, knowledge documents and media files</li>
                    <li>All conversations, messages, leads and bookings</li>
                    <li>Connected channels, settings, schedules and reports</li>
                    <li>All team members' logins, including yours</li>
                </ul>
                <p class="kw-help">This cannot be undone and there is no grace period. We will email a 6-digit code to{" "}
                    <span id="pro-delete-email">your account address</span> so we know it is you.</p>
                <div class="pro-formfoot">
                    <button type="button" class="kw-btn kw-btn-danger cr-press" id="pro-delete-request">Email me a code</button>
                </div>
            </div>
        </section>

        <!-- Native dialog. Everything outside it is inert while it is open, so
             the message that tells the person what happened lives inside it:
             a page-level live region would never be announced. -->
        <dialog id="pro-delete-dialog" class="pro-delete-dialog" aria-labelledby="pro-delete-dialog-title"
                aria-describedby="pro-delete-dialog-desc">
            <form id="pro-delete-form" novalidate>
                <div class="kw-modal-head">
                    <h2 id="pro-delete-dialog-title">Delete this workspace permanently?</h2>
                </div>
                <div class="kw-modal-body">
                    <p class="pro-delete-text" id="pro-delete-dialog-desc">Enter the 6-digit code we emailed you. The
                        workspace, its chatbots, conversations and team logins are deleted immediately and cannot be
                        recovered.</p>
                    <div class="kw-field">
                        <label class="kw-label" for="pro-delete-code">Confirmation code</label>
                        <input class="kw-input pro-delete-code" type="text" id="pro-delete-code" name="code"
                               inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern={"[0-9]{6}"}
                               spellcheck="false" aria-describedby="pro-delete-dialog-status">
                    </div>
                    <p class="kw-help pro-delete-status" id="pro-delete-dialog-status" role="status"
                       aria-live="polite"></p>
                </div>
                <div class="kw-modal-foot">
                    <button type="button" class="kw-btn cr-press" id="pro-delete-cancel">Cancel</button>
                    <button type="submit" class="kw-btn kw-btn-danger cr-press" id="pro-delete-confirm"
                            disabled>Delete workspace permanently</button>
                </div>
            </form>
        </dialog>

        <p class="kw-visually-hidden" role="status" aria-live="polite" id="pro-announce"></p>
    </main>

    <Fragment slot="end">
    <script is:inline src="assets/js/profile.js"></script>
    </Fragment>
</AppLayout>
