---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Conversations | Omnexa">
    <Fragment slot="head">
        <link rel="stylesheet" href="assets/css/conversations.css">
        <link rel="stylesheet" href="assets/css/product-tour.css">
        <script is:inline src="assets/js/product-tour.js" defer></script>
    </Fragment>

    <main class="main-container kw-page">
        <header class="kw-header">
            <div>
                <h1>Conversations</h1>
                <p class="kw-header-sub">
                    Every conversation across every bot, in one pipeline. Work it like a lead list.
                </p>
            </div>
            <span class="kw-badge kw-badge-support" id="conv-stale">
                <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
                Showing the last data we loaded
            </span>
        </header>

        <!-- ══════════════════════════════ PIPELINE ══════════════════════════════ -->
        <section id="conv-pipeline">
            <div class="kw-banner kw-banner-error" id="conv-load-error" hidden>
                <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
                <span id="conv-load-error-text">We could not load your conversations.</span>
                <button type="button" class="kw-btn cr-press" id="conv-retry" style="margin-left:auto;">Retry</button>
            </div>

            <div class="kw-stats" id="conv-stats" aria-hidden="false">
                <div class="kw-stat" data-stage="new">
                    <div class="kw-stat-head">
                        <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2"/><path d="M19 8v6M22 11h-6"/></svg></span>
                        <span class="kw-stat-label">New</span>
                    </div>
                    <div class="kw-stat-value kw-mono" data-part="value">-</div>
                </div>
                <div class="kw-stat" data-stage="contacted">
                    <div class="kw-stat-head">
                        <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></span>
                        <span class="kw-stat-label">Contacted</span>
                    </div>
                    <div class="kw-stat-value kw-mono" data-part="value">-</div>
                </div>
                <div class="kw-stat" data-stage="qualified">
                    <div class="kw-stat-head">
                        <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg></span>
                        <span class="kw-stat-label">Qualified</span>
                    </div>
                    <div class="kw-stat-value kw-mono" data-part="value">-</div>
                </div>
                <div class="kw-stat" data-stage="won">
                    <div class="kw-stat-head">
                        <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4Z"/><path d="M5 4H3v2a4 4 0 0 0 4 4M19 4h2v2a4 4 0 0 1-4 4"/></svg></span>
                        <span class="kw-stat-label">Won</span>
                    </div>
                    <div class="kw-stat-value kw-mono" data-part="value">-</div>
                </div>
                <div class="kw-stat" data-stage="lost">
                    <div class="kw-stat-head">
                        <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/></svg></span>
                        <span class="kw-stat-label">Lost</span>
                    </div>
                    <div class="kw-stat-value kw-mono" data-part="value">-</div>
                </div>
            </div>

            <div class="kw-toolbar" id="conv-toolbar">
                <div class="kw-search">
                    <svg class="dashboard-icon kw-search-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                    <label class="kw-visually-hidden" for="conv-search">Search conversations by customer name</label>
                    <input type="search" id="conv-search" placeholder="Search by name...">
                </div>
                <label class="kw-visually-hidden" for="conv-filter-channel">Filter by channel</label>
                <select class="kw-select" id="conv-filter-channel">
                    <option value="">All channels</option>
                </select>
                <button type="button" class="kw-chip" id="conv-chip-awaiting" data-filter="awaiting" aria-pressed="false">
                    Awaiting human
                </button>
                <button type="button" class="kw-chip" id="conv-chip-overdue" data-filter="overdue" aria-pressed="false">
                    Overdue
                </button>
            </div>

            <div id="conv-pipeline-loading">
                <div class="conv-group">
                    <div class="conv-group-head cr-skeleton" style="height:20px;width:140px;margin:14px 16px;"></div>
                    <div style="padding:0 16px 16px;display:flex;flex-direction:column;gap:10px;">
                        <div class="cr-skeleton" style="height:58px;border-radius:10px;"></div>
                        <div class="cr-skeleton" style="height:58px;border-radius:10px;"></div>
                        <div class="cr-skeleton" style="height:58px;border-radius:10px;"></div>
                    </div>
                </div>
            </div>

            <div class="kw-empty" id="conv-pipeline-empty" hidden>
                <span class="kw-empty-icon" aria-hidden="true">
                    <svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>
                </span>
                <h3 id="conv-pipeline-empty-title">No conversations yet</h3>
                <p id="conv-pipeline-empty-body">When a customer starts chatting with this bot, it will show up here.</p>
                <button type="button" class="kw-btn cr-press" id="conv-clear-filters" hidden>Clear filters</button>
            </div>

            <div id="conv-groups" hidden>
                <details class="conv-group" data-stage="new" open>
                    <summary class="conv-group-head" data-stage="new">
                        New <span class="kw-counter" data-part="count">0</span>
                        <svg class="dashboard-icon" data-part="chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div role="listbox" aria-label="New conversations" data-stage="new"></div>
                </details>
                <details class="conv-group" data-stage="contacted" open>
                    <summary class="conv-group-head" data-stage="contacted">
                        Contacted <span class="kw-counter" data-part="count">0</span>
                        <svg class="dashboard-icon" data-part="chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div role="listbox" aria-label="Contacted conversations" data-stage="contacted"></div>
                </details>
                <details class="conv-group" data-stage="qualified" open>
                    <summary class="conv-group-head" data-stage="qualified">
                        Qualified <span class="kw-counter" data-part="count">0</span>
                        <svg class="dashboard-icon" data-part="chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div role="listbox" aria-label="Qualified conversations" data-stage="qualified"></div>
                </details>
                <details class="conv-group" data-stage="won">
                    <summary class="conv-group-head" data-stage="won">
                        Won <span class="kw-counter" data-part="count">0</span>
                        <svg class="dashboard-icon" data-part="chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div role="listbox" aria-label="Won conversations" data-stage="won"></div>
                </details>
                <details class="conv-group" data-stage="lost">
                    <summary class="conv-group-head" data-stage="lost">
                        Lost <span class="kw-counter" data-part="count">0</span>
                        <svg class="dashboard-icon" data-part="chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <div role="listbox" aria-label="Lost conversations" data-stage="lost"></div>
                </details>
            </div>

            <p class="kw-visually-hidden" role="status" aria-live="polite" id="conv-announce-pipeline"></p>
        </section>

        <!-- ══════════════════════════════ WORKSPACE ══════════════════════════════ -->
        <section class="conv-workspace" id="conv-workspace" data-mobile-tab="lead" hidden>
            <a href="#" class="dashboard-back-link" id="conv-back-link">
                <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m12 19-7-7 7-7M5 12h14"/></svg>
                Back to pipeline
            </a>

            <div id="conv-mobile-strip">
                <p class="kw-help" id="conv-mobile-summary"></p>
                <div class="kw-segment" role="radiogroup" aria-label="Show" id="conv-mobile-segment">
                    <button type="button" role="radio" data-tab="lead" aria-checked="true">Lead</button>
                    <button type="button" role="radio" data-tab="transcript" aria-checked="false" tabindex="-1">Transcript</button>
                </div>
            </div>

            <nav class="kw-panel" id="conv-mini-rail" aria-label="Other conversations">
                <div class="kw-panel-head">
                    <h2 class="kw-panel-title">Pipeline <span class="kw-counter" id="conv-mini-count">0</span></h2>
                </div>
                <div class="kw-panel-body">
                    <div class="kw-queue" id="conv-mini-list" role="listbox" aria-label="Other conversations"></div>
                </div>
            </nav>

            <section class="kw-panel" id="conv-transcript-pane">
                <div class="kw-panel-head">
                    <div>
                        <h2 class="kw-panel-title" id="conv-transcript-heading" tabindex="-1">Conversation</h2>
                        <p class="kw-help" id="conv-transcript-sub"></p>
                    </div>
                    <span class="kw-pill kw-pill-review" id="conv-escalated-pill" hidden>Awaiting human</span>
                </div>
                <div id="conv-transcript-actions">
                    <button type="button" class="kw-btn cr-press" id="conv-copy-link">Copy link</button>
                    <button type="button" class="kw-btn cr-press" id="conv-copy-transcript">Copy transcript</button>
                    <button type="button" class="kw-btn cr-press" id="conv-download-transcript">Download .txt</button>
                    <label class="kw-visually-hidden" for="conv-message-search">Search transcript</label>
                    <input class="kw-input" type="search" id="conv-message-search" placeholder="Search transcript...">
                    <span class="kw-help" id="conv-message-search-count" role="status" aria-live="polite"></span>
                </div>
                <div class="kw-panel-body">
                    <div class="conv-transcript" id="conv-transcript" role="log" aria-live="polite" aria-relevant="additions" aria-labelledby="conv-transcript-heading"></div>

                    <section id="conv-held-panel" aria-labelledby="conv-held-title" hidden>
                        <h3 class="kw-panel-title" id="conv-held-title">Held replies</h3>
                        <fieldset id="conv-held-list" aria-labelledby="conv-held-title"></fieldset>
                    </section>
                    <p class="kw-help" id="conv-held-load-error" role="status"></p>

                    <div class="conv-composebar" id="conv-composebar">
                        <div class="kw-locked" id="conv-web-notice" hidden>
                            <span class="kw-locked-icon" aria-hidden="true">
                                <svg class="dashboard-icon" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                            </span>
                            <div>
                                <h4>No visitor chat is available for replies</h4>
                                <p>Test Lab sessions and conversations without a valid visitor session cannot receive replies. You can still resolve a handoff request below.</p>
                            </div>
                        </div>

                        <div data-part="row" id="conv-reply-row">
                            <label class="kw-visually-hidden" for="conv-reply-text">Reply to this conversation</label>
                            <textarea class="kw-textarea" id="conv-reply-text" data-sentry-mask rows="2" placeholder="Type a reply..." maxlength="2000"></textarea>
                            <button type="button" class="kw-btn kw-btn-primary cr-press" id="conv-reply-send">Send</button>
                            <button type="button" class="kw-btn cr-press" id="conv-held-cancel" hidden>Cancel edit</button>
                        </div>

                        <div data-part="actions">
                            <span class="kw-help" role="status" aria-live="polite" id="conv-compose-status"></span>
                            <button type="button" class="kw-btn cr-press" id="conv-resolve-btn" hidden>Mark as Resolved</button>
                        </div>
                    </div>
                </div>
            </section>

            <form class="kw-rail" id="conv-lead-rail" aria-label="Lead details">
                <div class="kw-rail-head">
                    <div class="kw-rail-ident">
                        <span class="conv-avatar" id="conv-rail-avatar" aria-hidden="true">?</span>
                        <div>
                            <p class="kw-rail-title" id="conv-rail-name">-</p>
                            <div class="kw-rail-badges" id="conv-rail-badges"></div>
                        </div>
                    </div>
                </div>
                <div class="kw-rail-body">
                    <dl class="kw-deflist">
                        <dt>Phone</dt><dd class="kw-mono" id="conv-field-phone">-</dd>
                        <dt>Bot</dt><dd id="conv-field-bot">-</dd>
                        <dt>Channel</dt><dd id="conv-field-channel">-</dd>
                        <dt>Type</dt><dd id="conv-field-type">-</dd>
                    </dl>

                    <div class="kw-field">
                        <span class="kw-label">Summary</span>
                        <p class="kw-desc" id="conv-field-summary">No summary yet.</p>
                    </div>

                    <div class="kw-field">
                        <fieldset>
                            <legend>Stage</legend>
                            <div class="kw-segment" role="radiogroup" aria-label="Stage" id="conv-stage-group">
                                <button type="button" role="radio" data-stage="new" aria-checked="true">New</button>
                                <button type="button" role="radio" data-stage="contacted" aria-checked="false" tabindex="-1">Contacted</button>
                                <button type="button" role="radio" data-stage="qualified" aria-checked="false" tabindex="-1">Qualified</button>
                                <button type="button" role="radio" data-stage="won" aria-checked="false" tabindex="-1">Won</button>
                                <button type="button" role="radio" data-stage="lost" aria-checked="false" tabindex="-1">Lost</button>
                            </div>
                        </fieldset>
                        <span class="kw-help" role="status" aria-live="polite" id="conv-stage-status"></span>
                    </div>

                    <div class="kw-field">
                        <fieldset>
                            <legend>Priority</legend>
                            <div class="kw-segment" role="radiogroup" aria-label="Priority" id="conv-priority-group">
                                <button type="button" role="radio" data-priority="low" aria-checked="false" tabindex="-1">Low</button>
                                <button type="button" role="radio" data-priority="medium" aria-checked="true">Medium</button>
                                <button type="button" role="radio" data-priority="high" aria-checked="false" tabindex="-1">High</button>
                            </div>
                        </fieldset>
                        <span class="kw-help" role="status" aria-live="polite" id="conv-priority-status"></span>
                    </div>

                    <div class="kw-field">
                        <label class="kw-label" for="conv-followup">Follow-up date</label>
                        <input class="kw-input" type="date" id="conv-followup">
                        <span class="kw-help" role="status" aria-live="polite" id="conv-followup-status"></span>
                    </div>

                    <div class="kw-field" id="conv-owner-field">
                        <label class="kw-label" for="conv-owner">Owner</label>
                        <select class="kw-select" id="conv-owner">
                            <option value="">Unassigned</option>
                        </select>
                        <span class="kw-help" role="status" aria-live="polite" id="conv-owner-status"></span>
                    </div>

                    <div class="kw-field">
                        <label class="kw-label" for="conv-notes">Notes</label>
                        <textarea class="kw-textarea" id="conv-notes" rows="4" maxlength="1000"></textarea>
                        <div data-part="notes-actions">
                            <button type="button" class="kw-btn cr-press" id="conv-notes-save">Save notes</button>
                            <span class="kw-help" role="status" aria-live="polite" id="conv-notes-status"></span>
                        </div>
                    </div>
                </div>
            </form>

            <p class="kw-visually-hidden" role="status" aria-live="polite" id="conv-announce-workspace"></p>
        </section>
    </main>

    <Fragment slot="end">
        <script is:inline src="assets/js/conversations.js"></script>
    </Fragment>
</AppLayout>
