<!DOCTYPE html>
<html lang="en">
<head>
    <script is:inline src="assets/js/theme-boot.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Accept invitation | Omnexa</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <meta name="description" content="Accept your invitation and join a Omnexa workspace.">
    <meta name="robots" content="noindex,follow">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Geist:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/auth-volleo.css">
    <link rel="stylesheet" href="assets/css/app-preferences.css">
    <script is:inline defer src="assets/js/app-preferences.js"></script>
</head>
<body>
    <div class="auth-shell">
        <main class="auth-main">
            <div class="auth-card">
                <a class="auth-brand" href="landing.html"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 4.2h9.8l-3.1 4H3.9z" fill="currentColor"/><path d="M5.5 10h9.8l-3.1 4H2.4z" fill="currentColor"/><path d="M4 15.8h9.8l-3.1 4H0.9z" fill="currentColor"/></svg> Omnexa</a>

                <!-- Loading State -->
                <div id="loadingState" class="loading-state">
                    <div class="spinner" aria-hidden="true"></div>
                    <p role="status">Checking your invitation...</p>
                </div>

                <!-- Invalid / Expired State -->
                <div id="invalidState" class="invalid-state" role="alert">
                    <h3 id="invalidTitle">Invalid invitation</h3>
                    <p id="invalidMessage">This invite link is invalid or has expired.</p>
                    <a href="login.html" class="btn btn-primary">Go to sign in</a>
                </div>

                <!-- Accept Form -->
                <div id="formSection" class="form-section">
                    <div class="auth-head">
                        <h1>Accept your invitation</h1>
                        <p>You have been invited to join <span id="companyDisplay" class="email-highlight">the team</span>.</p>
                    </div>

                    <div class="info-card">
                        <span class="info-icon" aria-hidden="true">&#9993;</span>
                        <div class="info-text" is:raw>
                            Invited as <strong id="invitedRole">Member</strong> &middot;
                            <span id="invitedEmail">user@example.com</span>
                        </div>
                    </div>

                    <div id="inviteMessage" class="message-box" role="alert" aria-live="assertive" aria-atomic="true"></div>

                    <form id="acceptForm" onsubmit="return handleSubmit(event)">
                        <div class="input-group">
                            <label for="fullName">Full name</label>
                            <input type="text" id="fullName" placeholder="Marcus Vance" autocomplete="name" required aria-describedby="inviteMessage">
                        </div>

                        <div class="input-group">
                            <label for="password">Password</label>
                            <div class="password-field">
                                <input type="password" id="password" placeholder="Create a strong password" autocomplete="new-password" required aria-describedby="password-requirements">
                                <button type="button" class="password-toggle" onclick="togglePwd('password', this)" aria-label="Show password">Show</button>
                            </div>
                            <p class="password-hint" id="password-requirements">Minimum 8 characters, with one uppercase letter, one number and one special character.</p>
                        </div>

                        <div class="input-group">
                            <label for="confirmPassword">Confirm password</label>
                            <div class="password-field">
                                <input type="password" id="confirmPassword" placeholder="Re-enter your password" autocomplete="new-password" required aria-describedby="inviteMessage">
                                <button type="button" class="password-toggle" onclick="togglePwd('confirmPassword', this)" aria-label="Show password">Show</button>
                            </div>
                        </div>

                        <div class="cf-turnstile"></div>

                        <button type="submit" id="submitBtn" class="btn btn-primary">
                            <span class="btn-text">Create account</span>
                            <span class="btn-loader"></span>
                        </button>
                    </form>

                    <div id="googleInviteSection" class="google-invite-section" hidden>
                        <div class="invite-divider">OR</div>
                        <div id="googleInviteButton" class="google-invite-button" aria-label="Continue with Google"></div>
                    </div>

                    <p class="footer-text">Already have an account? <a href="login.html">Sign in</a></p>
                </div>

                <!-- Success State (initially hidden) -->
                <div id="successState" class="invalid-state" style="display:none;" role="status">
                    <h3>Account created</h3>
                    <p>Your account is ready. Redirecting you to sign in...</p>
                    <a href="login.html" class="btn btn-primary">Go to sign in</a>
                </div>
            </div>
        </main>
        <aside class="auth-aside">
            <img class="auth-visual" src="https://manertvcpqtsmegqvhuc.supabase.co/storage/v1/object/public/landing/img/auth-invite.webp" alt="" aria-hidden="true" decoding="async" width="540" height="540">
        </aside>
    </div>

    <script is:inline src="assets/js/turnstile-guard.js"></script>
    <script is:inline src="assets/js/auth-sentry.js"></script>
    <script is:inline src="assets/js/auth.js"></script>
    <script is:inline src="assets/js/accept-invite.js"></script>
    <script is:inline src="https://accounts.google.com/gsi/client" async defer
            onload="handleGoogleLibraryLoad()" onerror="handleGoogleLibraryError()"></script>
</body>
</html>
