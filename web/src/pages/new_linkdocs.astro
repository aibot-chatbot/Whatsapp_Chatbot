<!DOCTYPE html>
<html lang="en">

<head>
    <script is:inline src="assets/js/theme-boot.js"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Links & Documents | Omnexa</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml">

    {/* @ts-expect-error Astro types script crossorigin as a string. Preserve the bare CDN attribute. */}
    <script is:inline crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    {/* @ts-expect-error ReactDOM uses the same bare crossorigin attribute. */}
    <script is:inline crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Import Vis.js for Knowledge Graph visualization -->
    <script is:inline type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>
    <!-- Pinned to match bots.html. Icons replace the emoji this page used as
         controls; DESIGN.md lists emoji controls under "Avoid". -->
    <script is:inline src="https://unpkg.com/lucide@1.31.0"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/shared-glass.css">
    <!-- Loaded after shared-glass so the control-room system wins, matching
         the migration pattern already used by index.html and bots.html. -->
    <link rel="stylesheet" href="assets/css/dashboard-control-room.css">
    <link rel="stylesheet" href="assets/css/bot-setup-journey.css">
    <script is:inline src="assets/js/bot-setup-journey.js" defer></script>
    <link rel="stylesheet" href="assets/css/product-tour.css">
    <script is:inline src="assets/js/product-tour.js" defer></script>
    <script is:inline src="assets/js/shared-ui.js"></script>
    <script is:inline src="assets/js/auth.js"></script>
    <script is:inline src="assets/js/require-login.js"></script>
    <script is:inline src="assets/js/require-admin-or-owner.js"></script>
    <script is:inline src="sidebar-component.js"></script>

    <style is:inline>
        /* The shell, palette, typography and every knowledge-workspace
           component live in assets/css/dashboard-control-room.css. What stays
           here is the legacy variable surface: the JSX below still names
           --primary / --text-dim / --card-bg in inline styles and in the
           colours handed to vis-network, so those names are repointed at
           control-room tokens once instead of being edited at each call site.
           Nothing in this block introduces a colour of its own. */
        :root {
            --primary: var(--control-accent);
            --primary-glow: transparent;
            --bg: var(--control-canvas);
            --card-bg: var(--control-panel);
            --input-bg: var(--control-sunken);
            --text: var(--control-text);
            --text-main: var(--control-text);
            --text-dim: var(--control-text-secondary);
            --glass-border: var(--control-border);
            --border: var(--control-border);
            --accent: var(--control-accent);
            --error: var(--control-danger);
            --warning: var(--control-warning);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            overflow-x: hidden;
        }

        #root {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        .kw-operation-panel {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 12px;
            padding: 12px;
            border: 1px solid var(--control-border);
            border-radius: 8px;
            background: var(--control-sunken);
        }

        .kw-operation-title {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--control-text);
            font-size: 13px;
            font-weight: 600;
        }

        .kw-operation-bar {
            position: relative;
            overflow: hidden;
            height: 6px;
            border-radius: 999px;
            background: var(--control-border);
        }

        .kw-operation-bar::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: -35%;
            width: 35%;
            border-radius: inherit;
            background: var(--control-accent);
            animation: kw-operation-slide 1.15s ease-in-out infinite;
        }

        .kw-operation-meta {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            gap: 8px;
            color: var(--control-text-secondary);
            font-size: 12px;
        }

        @keyframes kw-operation-slide {
            0% { left: -35%; }
            100% { left: 100%; }
        }

        .kw-guided-upload { padding: 28px; }
        .kw-guided-upload h2 { font-size: 20px; margin: 0 0 10px; }
        .kw-guided-upload p { max-width: 60ch; color: var(--control-text-secondary); line-height: 1.6; }
        .kw-guided-upload .kw-btn { margin-top: 16px; }
        .kw-guided-upload .kw-evidence-source { margin: 16px 0; overflow-wrap: anywhere; }
        .kw-guided-tools-toggle { margin: 16px 0; }
        .kw-page [hidden] { display: none !important; }
        @media (max-width: 600px) { .kw-guided-upload { padding: 20px; } }
    </style>
    <link rel="stylesheet" href="assets/css/app-preferences.css">
    <script is:inline defer src="assets/js/app-preferences.js"></script>
</head>

<body class="dashboard-page">
    <div id="root"></div>

    <script is:inline defer src="assets/js/new_linkdocs.js"></script>
</body>
</html>
