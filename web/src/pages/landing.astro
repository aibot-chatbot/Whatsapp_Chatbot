---
// Like-for-like move of frontend/landing.html. is:inline keeps every script and the <style> exactly as
// written and in place: no bundling, no reordering, no scoped-CSS attributes. The three former inline
// scripts are landing-theme-boot.js, landing-motion.js and landing-plans.js; JSON-LD stays inline.
---
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Omnexa | WhatsApp Telegram AI chatbot, CRM and broadcasts for Malaysian businesses</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
<meta name="description" content="Omnexa combines AI chatbots and GEO analysis for Malaysian businesses. Paid plans start from RM 89 per month equivalent on a 12-month prepaid term.">
<link rel="canonical" href="https://omnexa.io/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Omnexa">
<meta property="og:locale" content="en_MY">
<meta property="og:title" content="WhatsApp AI Chatbot for Malaysian Businesses | Omnexa">
<meta property="og:description" content="Answer customers on WhatsApp, Telegram and website chat from your own documents, with a built-in CRM. 7-day free trial, no card required.">
<meta property="og:url" content="https://omnexa.io/">
<meta property="og:image" content="https://manertvcpqtsmegqvhuc.supabase.co/storage/v1/object/public/landing/img/sys-endtoend.webp">
<meta property="og:image:alt" content="The Omnexa robot sending a message through glowing pipelines across a city, fanning out to many channels">
<meta name="twitter:card" content="summary_large_image">
<meta name="robots" content="max-image-preview:large">
<meta name="theme-color" id="theme-color" content="#060A12">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://manertvcpqtsmegqvhuc.supabase.co" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Geist:wght@400;500&display=swap" rel="stylesheet">
<link rel="preload" as="image" fetchpriority="high"
  href="https://manertvcpqtsmegqvhuc.supabase.co/storage/v1/object/public/landing/img/robot-reference.webp">
<script is:inline src="assets/js/landing-theme-boot.js"></script>
<style is:inline>
:root{
  --void:#060A12; --panel:rgba(18,26,38,.62); --cyan:#22D3EE; --sky:#38BDF8;
  --ice:#F1F5F9; --steel:#94A3B8; --hair:rgba(34,211,238,.15); --line:rgba(148,163,184,.14);
  --on-cyan:#04121a; --lift:0 20px 50px rgba(0,0,0,.35);
  color-scheme:dark;
}
/* "warm paper": cream page, warm-white cards, charcoal text (14:1) and a deep teal
   that passes AA (4.9:1); the same palette as the dashboard's light mode */
[data-theme="light"]{
  --void:#F6F5F1; --panel:rgba(251,250,247,.92); --cyan:#0E7490; --sky:#0B6478;
  --ice:#23241F; --steel:#58574F; --hair:rgba(14,116,144,.2); --line:rgba(35,36,31,.12);
  --on-cyan:#FFFFFF; --lift:0 1px 2px rgba(35,36,31,.04),0 18px 40px -18px rgba(35,36,31,.18);
  color-scheme:light;
}
[data-theme="light"] :is(.plan,.uc,.chan .c,.facts,.panel){box-shadow:var(--lift)}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--void);color:var(--ice);font-family:Geist,system-ui,sans-serif;
  -webkit-font-smoothing:antialiased;line-height:1.6;overflow-x:hidden;
  transition:background-color .2s ease,color .2s ease}
h1,h2,h3,.display{font-family:'Space Grotesk',system-ui,sans-serif;letter-spacing:-.03em;margin:0;line-height:1.08}
a{color:inherit}
/* Use padding-inline / padding-block, NOT the `padding` shorthand.
   Every section also carries .wrap, and .wrap (0,1,0) outranks section (0,0,1) -
   with both writing `padding`, the class silently zeroed every section's
   vertical padding and the sections stacked flush against each other. */
.wrap{max-width:1400px;margin:0 auto;padding-inline:clamp(20px,5vw,64px)}
section{padding-block:clamp(76px,9vw,140px)}
/* a hairline keeps the rhythm readable where two text sections meet */
section + section{border-top:1px solid var(--line)}
.hero{border-top:0}
.eyebrow{display:inline-flex;align-items:center;gap:.5rem;font-size:.75rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--cyan);border:1px solid var(--hair);border-radius:999px;
  padding:.4rem .85rem;background:color-mix(in srgb,var(--cyan) 6%,transparent)}
.dot{width:6px;height:6px;border-radius:50%;background:var(--cyan);box-shadow:0 0 8px var(--cyan);animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}
h2{font-size:clamp(1.9rem,3.6vw,2.9rem);margin:1rem 0 .6rem}
.lede{color:var(--steel);max-width:62ch}
.btn{display:inline-block;background:var(--cyan);color:var(--on-cyan);border:0;border-radius:12px;
  padding:.95rem 1.7rem;font:500 1rem Geist,sans-serif;cursor:pointer;text-decoration:none;
  transition:transform .12s ease}
.btn:active{transform:translateY(1px)}
.btn:focus-visible,a:focus-visible,button:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
.muted{color:var(--steel);font-size:.9rem}
.trial-cta{display:flex;align-items:center;gap:.9rem;margin-top:1.8rem}
.trial-cta .trial-note{margin:0}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;backdrop-filter:blur(10px)}
img{max-width:100%;height:auto;display:block}

header{position:sticky;top:0;z-index:50;backdrop-filter:blur(14px);
  background:color-mix(in srgb,var(--void) 82%,transparent);border-bottom:1px solid var(--hair)}
.nav{display:flex;align-items:center;gap:1.6rem;padding:.9rem 0}
.brand{display:flex;align-items:center;gap:.6rem;font-family:'Space Grotesk';font-weight:700;font-size:1.15rem;text-decoration:none}
.mark{width:22px;height:22px;flex:none}
.nav ul{display:flex;gap:1.4rem;list-style:none;margin:0;padding:0;font-size:.94rem}
.nav ul a{text-decoration:none;color:var(--steel)}
.nav ul a:hover{color:var(--ice)}
.spacer{margin-left:auto}
.nav-tools{display:flex;align-items:center;gap:.55rem}
.lang-select{height:38px;min-width:122px;border:1px solid var(--line);border-radius:10px;
  background:color-mix(in srgb,var(--void) 88%,transparent);color:var(--ice);
  padding:0 2rem 0 .75rem;font:500 .84rem Geist,sans-serif;cursor:pointer}
.lang-select:focus-visible{outline:2px solid var(--cyan);outline-offset:3px}
[data-theme="light"] .lang-select option,
[data-theme="light"] .lang-select optgroup{background:#FBFAF7;color:#23241F}
.icon-btn{background:none;border:1px solid var(--line);border-radius:10px;color:var(--steel);
  width:38px;height:38px;cursor:pointer;font-size:1.05rem;display:grid;place-items:center;flex:none}
.theme-glyph{line-height:1;transform:translateY(-1px)}

h1{font-size:clamp(2.4rem,5.4vw,4.3rem);margin:1.1rem 0 1.1rem}
.chips{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:2.2rem}
.chip{display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--line);border-radius:999px;
  padding:.35rem .8rem;font-size:.82rem;color:var(--steel)}
.chip.soon{opacity:.45}
.chip.soon b{font-weight:500;font-size:.66rem;letter-spacing:.08em;text-transform:uppercase;color:var(--cyan)}

/* ---- cinema: a full-screen film hero, then three product chapters ----
   Without GSAP, or with reduced motion, it is a hero plus three chapter cards.
   The script adds .is-pinned for the scroll-driven version. The film is dark in
   both themes, so the palette is pinned to the dark tokens inside it. */
.cinema{--void:#060A12;--ice:#F1F5F9;--steel:#CBD5E1;--cyan:#22D3EE;--on-cyan:#04121a;
  --line:rgba(148,163,184,.26);--hair:rgba(34,211,238,.22);
  position:relative;background:var(--void);color:var(--ice);color-scheme:dark;counter-reset:ch}
.cine-media{position:absolute;inset:0 0 auto;height:calc(100svh - var(--hdr,64px));overflow:hidden}
.cine-media video,.chapter video{display:block;width:100%;height:100%;object-fit:cover}
#robot{position:absolute;inset:0;z-index:0}
.cine-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;transition:opacity .7s ease}
.hero-veil{background:
  linear-gradient(90deg,rgba(6,10,18,.94) 0%,rgba(6,10,18,.8) 34%,rgba(6,10,18,.35) 68%,rgba(6,10,18,.15) 100%),
  linear-gradient(0deg,rgba(6,10,18,.9) 0%,transparent 38%)}
.chapter-veil{opacity:0;background:
  linear-gradient(270deg,rgba(6,10,18,.9) 0%,rgba(6,10,18,.55) 36%,transparent 66%),
  linear-gradient(0deg,rgba(6,10,18,.85) 0%,transparent 46%)}
.hero{position:relative;z-index:2;display:flex;align-items:center;
  min-height:calc(100svh - var(--hdr,64px));padding-block:clamp(48px,8vh,96px)}
.hero-copy{max-width:44rem}
.scroll-hint{display:inline-flex;align-items:center;gap:.7rem;margin-top:2.4rem;color:var(--steel);
  font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;text-decoration:none}
.scroll-hint::after{content:'';width:1px;height:34px;background:linear-gradient(var(--cyan),transparent);
  transform-origin:top;animation:drip 1.8s ease-in-out infinite}
@keyframes drip{0%{transform:scaleY(0)}55%{transform:scaleY(1);opacity:1}100%{transform:scaleY(1);opacity:0}}
.chapters{position:relative;z-index:2;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:22px;padding-block:0 clamp(76px,9vw,140px)}
.chapter{counter-increment:ch}
.chapter video{height:auto;aspect-ratio:16/9;border-radius:16px;border:1px solid var(--line)}
.ch-text{padding-top:18px}
.ch-kicker{margin:0;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:var(--cyan)}
.ch-kicker::before{content:counter(ch,decimal-leading-zero) " / 03";margin-right:.8rem;color:var(--steel)}
.chapter h2{font-size:clamp(1.5rem,3vw,2.6rem);margin:.6rem 0 .5rem}
.ch-copy{margin:0;color:var(--steel);max-width:40ch}
.ch-dots{display:none}

.cinema.is-pinned{height:calc(100svh - var(--hdr,64px));overflow:hidden}
.is-pinned .cine-media{inset:0;height:auto}
.is-pinned .hero{position:absolute;inset:0;min-height:0;
  transition:opacity .5s ease,transform .5s ease,visibility 0s linear 0s}
.is-pinned:not([data-step="0"]) .hero{opacity:0;transform:translateY(-28px);visibility:hidden;
  transition:opacity .5s ease,transform .5s ease,visibility 0s linear .5s}
.is-pinned:not([data-step="0"]) .hero-veil{opacity:0}
.is-pinned:not([data-step="0"]) .chapter-veil{opacity:1}
/* z-index:auto so the clips (0), the scrims (1) and the copy (2) share one stack */
.is-pinned .chapters{position:absolute;inset:0;z-index:auto;display:block;padding:0;max-width:none}
.is-pinned .chapter video{position:absolute;inset:0;z-index:0;height:100%;aspect-ratio:auto;
  border:0;border-radius:0;opacity:0;transition:opacity .8s ease}
.is-pinned .chapter.is-active video{opacity:1}
.is-pinned .ch-text{position:absolute;z-index:2;right:clamp(36px,5vw,72px);bottom:clamp(40px,10vh,110px);
  width:min(36rem,calc(100% - 72px));padding:0;opacity:0;transform:translateY(28px);visibility:hidden;
  transition:opacity .5s ease,transform .5s ease,visibility 0s linear .5s}
.is-pinned .chapter.is-active .ch-text{opacity:1;transform:none;visibility:visible;
  transition:opacity .6s ease .15s,transform .6s ease .15s,visibility 0s}
.is-pinned .ch-dots{display:grid;gap:10px;position:absolute;z-index:2;right:clamp(14px,2vw,28px);top:50%;
  transform:translateY(-50%);list-style:none;margin:0;padding:0;opacity:0;transition:opacity .4s}
.is-pinned:not([data-step="0"]) .ch-dots{opacity:1}
.ch-dots li{width:3px;height:26px;border-radius:2px;background:rgba(241,245,249,.25);transition:background .3s,box-shadow .3s}
.is-pinned[data-step="1"] .ch-dots li:nth-child(1),
.is-pinned[data-step="2"] .ch-dots li:nth-child(2),
.is-pinned[data-step="3"] .ch-dots li:nth-child(3){background:var(--cyan);box-shadow:0 0 10px var(--cyan)}

.demo{display:grid;grid-template-columns:40fr 60fr;gap:clamp(24px,4vw,60px);align-items:center}
.demo-frame{width:100%;max-width:640px;justify-self:end;border-radius:22px;overflow:hidden;
  border:1px solid var(--hair);background:#060A12;box-shadow:var(--lift)}
.demo-frame video{display:block;width:100%;aspect-ratio:1;object-fit:cover}


.steps{display:grid;gap:20px;margin-top:2.4rem}
.step{padding:22px 24px;border-left:2px solid var(--hair)}
.step:nth-child(2){margin-left:clamp(0px,6vw,110px)}
.step:nth-child(3){margin-left:clamp(0px,3vw,54px)}
.step .n{font-family:'Space Grotesk';color:var(--cyan);font-size:.82rem;letter-spacing:.1em}
.zig{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,60px);align-items:center;margin-top:3rem}
.zig:nth-of-type(even) .zig-art{order:-1}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:22px;margin-top:2.6rem}
.uc{padding:0 0 22px;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--panel)}
.uc img{width:100%;aspect-ratio:4/3;object-fit:cover}
.uc .body{padding:18px 22px 0}
.uc h3{font-size:1.15rem;margin-bottom:.5rem}
.cap{font-size:.78rem;color:var(--steel);margin-top:.6rem}

.chan{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;margin-top:2.4rem}
.chan .c{padding:20px;border:1px solid var(--line);border-radius:16px;background:var(--panel)}
.chan .c img{aspect-ratio:4/3;object-fit:cover;border-radius:10px;margin-bottom:14px}
.roadmap{margin-top:26px;padding:20px;border:1px dashed var(--line);border-radius:16px;opacity:.72}

.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0;margin-top:2.4rem;
  border:1px solid var(--line);border-radius:18px;overflow:hidden;background:var(--panel)}
.facts div{padding:24px;border-right:1px solid var(--hair)}
.facts div:last-child{border-right:0}
.facts b{display:block;font-family:'Space Grotesk';font-size:1.5rem;margin-bottom:.3rem}

.founder{display:flex;gap:18px;margin-top:26px;padding:24px;align-items:flex-start}
.mono{width:52px;height:52px;flex:none;border-radius:12px;display:grid;place-items:center;
  background:color-mix(in srgb,var(--cyan) 16%,transparent);color:var(--cyan);
  font-family:'Space Grotesk';font-weight:700}
.trust{margin-top:26px;padding:24px 26px}
.trust h3{font-size:1.15rem;margin-bottom:.4rem}
.trust ul{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.trust li{padding:.55rem 0;border-bottom:1px solid var(--hair);color:var(--steel)}
.trust li:last-child{border-bottom:0}
.trust b{color:var(--ice);font-weight:500}
.trust a{color:var(--cyan)}
.trial{color:var(--cyan);font-size:.85rem}

/* 4, 2 or 1 columns - never 3+1, which strands Pro on a row of its own */
.plans{display:grid;grid-template-columns:repeat(4,1fr);column-gap:20px;margin-top:2rem}
@media (max-width:1100px){.plans{grid-template-columns:repeat(2,1fr)}}
@media (max-width:600px){.plans{grid-template-columns:1fr}}
/* Every card spans the same five rows (name, price, term line, CTA, features) through
   subgrid, so prices, buttons and the first feature line up across cards however the
   text wraps or translates. The parent keeps row-gap 0: a gap there would also open
   between a card's own rows. Same padding on every card, or the rows drift apart. */
.plan{display:grid;grid-row:span 5;grid-template-rows:subgrid;row-gap:0;margin-bottom:20px;
  padding:26px 24px;border:1px solid var(--line);border-radius:18px;background:var(--panel)}
.plan.rec{border-color:var(--cyan);box-shadow:0 0 0 1px var(--cyan),var(--lift)}
.price{font-family:'Space Grotesk';font-size:2.1rem;line-height:1.15;margin:.5rem 0 .4rem}
.plan .trial,.plan .term-total{margin:0 0 1.2rem}
.plan .btn{text-align:center;align-self:start}
.tbc{display:inline-block;font-family:'Space Grotesk';font-size:1rem;border:1px dashed var(--cyan);
  color:var(--cyan);border-radius:10px;padding:.3rem .8rem;margin:.5rem 0}
.plan ul{list-style:none;padding:0;margin:1.4rem 0 0;font-size:.9rem;color:var(--steel)}
.plan li{padding:.32rem 0;border-bottom:1px solid var(--hair)}
.plan li:last-child{border-bottom:0}
.notice{margin-top:1rem;padding:12px 16px;border-left:2px solid var(--cyan);color:var(--steel);font-size:.9rem}
.term-picker{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;margin:1.4rem 0 0}
.term-picker>span{color:var(--steel);font-size:.9rem;margin-right:4px}
.term-option{border:1px solid var(--line);border-radius:10px;background:var(--panel);color:var(--steel);padding:.58rem .9rem;cursor:pointer;font:500 .88rem Geist,system-ui,sans-serif}
.term-option:hover,.term-option:focus-visible{border-color:var(--cyan);color:var(--ice)}
.term-option.is-selected{border-color:var(--cyan);background:color-mix(in srgb,var(--cyan) 12%,var(--panel));color:var(--cyan)}
/* own line under the figure, so "/ month equivalent" never breaks mid-phrase */
.price small{display:block;margin-top:.3rem;font:400 .78rem/1.4 Geist,system-ui,sans-serif;color:var(--steel)}
.term-total{color:var(--steel);font-size:.78rem}

details{border-bottom:1px solid var(--line);padding:18px 0}
summary{cursor:pointer;font-family:'Space Grotesk';font-size:1.06rem;list-style:none}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';float:right;color:var(--cyan)}
details[open] summary::after{content:'\2212'}
details p{color:var(--steel);margin:.8rem 0 0;max-width:80ch}

.closing{position:relative;border-radius:22px;overflow:hidden;padding:clamp(38px,6vw,76px);margin-top:1rem}
.closing img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.closing .veil{position:absolute;inset:0;z-index:1;
  background:linear-gradient(90deg,var(--void) 6%,color-mix(in srgb,var(--void) 72%,transparent) 42%,transparent 74%)}
.closing .inner{position:relative;z-index:2;max-width:46ch}
footer{border-top:1px solid var(--hair);padding:52px 0 34px}
.fcols{display:grid;grid-template-columns:1.6fr repeat(4,1fr);gap:26px}
.fcols h4{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--steel);margin:0 0 .7rem}
.fcols ul{list-style:none;margin:0;padding:0;font-size:.92rem}
.fcols li{padding:.25rem 0}
.fcols a{color:var(--steel);text-decoration:none}
.fcols a:hover{color:var(--ice)}
.fbar{display:flex;gap:14px;align-items:center;margin-top:34px;padding-top:20px;border-top:1px solid var(--hair);color:var(--steel);font-size:.86rem}

@media (max-width:900px){
  .zig,.demo{grid-template-columns:1fr}
  .zig:nth-of-type(even) .zig-art{order:0}
  .demo-frame{justify-self:stretch;max-width:none}
  .nav ul{display:none}
  .nav{gap:.8rem;flex-wrap:wrap}
  .nav .spacer{display:none}
  .nav-tools{margin-left:auto}
  .fcols{grid-template-columns:1fr 1fr}
  .facts div{border-right:0;border-bottom:1px solid var(--hair)}
}
@media (max-width:620px){
  .nav{padding:.7rem 0}
  .nav-tools{order:3;width:100%;display:grid;grid-template-columns:minmax(0,1fr) 42px}
  .lang-select{width:100%;min-width:0}
  .nav > .muted{margin-left:auto}
  .nav > .btn{padding:.72rem 1rem;font-size:.86rem}
  .trial-cta{align-items:flex-start;flex-direction:column;gap:.65rem}
  h1{font-size:clamp(2.2rem,12vw,3.2rem)}
  .hero-veil{background:linear-gradient(0deg,rgba(6,10,18,.95) 0%,rgba(6,10,18,.8) 100%)}
  .is-pinned .ch-text{left:20px;right:auto;bottom:28px;width:calc(100% - 56px)}
  .chapter-veil{background:linear-gradient(0deg,rgba(6,10,18,.94) 0%,rgba(6,10,18,.62) 42%,transparent 72%)}
}
@media (max-width:460px){
  .nav > .btn{display:none}
  .fcols{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .dot,.scroll-hint::after{animation:none}
  .spec{display:none}
}
</style>
</head>
<body>

<header>
  <nav class="nav wrap" aria-label="Primary">
    <a class="brand" href="#top">
      <svg class="mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M7 4.2h9.8l-3.1 4H3.9z" fill="currentColor"/>
        <path d="M5.5 10h9.8l-3.1 4H2.4z" fill="currentColor"/>
        <path d="M4 15.8h9.8l-3.1 4H0.9z" fill="currentColor"/>
      </svg>
      Omnexa
    </a>
    <ul>
      <li><a href="#features">Features</a></li>
      <li><a href="#integrations">Integrations</a></li>
      <li><a href="#pricing">Pricing</a></li>
      <li><a href="#faq">FAQ</a></li>
    </ul>
    <span class="spacer"></span>
    <div class="nav-tools">
      <select class="lang-select" id="language-select" aria-label="Language">
        <option value="en">English</option>
        <option value="zh-CN">简体中文</option>
        <option value="ms">Bahasa Melayu</option>
      </select>
      <button class="icon-btn" id="theme-toggle" type="button"
