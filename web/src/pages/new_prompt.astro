---
// Bot Configuration on the shared tenant frame (F5); new_prompt.js keeps the page logic verbatim.
// AppLayout supplies theme/login boot; adminOnly preserves requireAdminOrOwner.
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Bot Configuration | Omnexa" adminOnly>
    <Fragment slot="head">
    <link rel="stylesheet" href="assets/css/bot-config.css">
    <link rel="stylesheet" href="assets/css/bot-setup-journey.css">
    <script is:inline src="assets/js/bot-setup-journey.js" defer></script>
    <link rel="stylesheet" href="assets/css/product-tour.css">
    <script is:inline src="assets/js/product-tour.js" defer></script>
    <script is:inline src="assets/js/industry-template.js" defer></script>
    </Fragment>

    <main class="main-container bc-page">
        <bot-setup-journey id="bc-setup-journey" current="instructions" hidden></bot-setup-journey>
        <header class="bc-header cr-reveal">
            <div>
                <h1 class="bc-title">
                    <span id="bc-page-title">Bot configuration</span>
                    <span class="bc-title-sep" aria-hidden="true">/</span>
                    <span class="bc-title-bot" id="bc-bot-name">&hellip;</span>
                </h1>
                <p class="bc-subtitle">Configure knowledge, behaviour and deployment settings for your bot.</p>
            </div>
            <div class="bc-header-aside">
                <a class="kw-btn cr-press" id="bc-dashboard-link" href="index.html">
                    View Bot Dashboard
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
                </a>
            </div>
        </header>

        <!-- Wizard rail: Profile -> Knowledge -> Validate -> Deploy.
             Each step maps to one existing endpoint; see the JS below. -->
        <section class="kw-panel bc-wizard cr-reveal" aria-labelledby="bc-wizard-title">
            <h2 class="kw-visually-hidden" id="bc-wizard-title">Setup progress</h2>
            <ol class="bc-steps" id="bc-steps">
                <li class="bc-step" data-step="profile">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="bc-step-body">
                        <span class="bc-step-name">1. Profile</span>
                        <span class="bc-step-note">Checking&hellip;</span>
                    </span>
                </li>
                <li class="bc-step" data-step="knowledge">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="bc-step-body">
                        <span class="bc-step-name">2. Knowledge</span>
                        <span class="bc-step-note">Checking&hellip;</span>
                    </span>
                </li>
                <li class="bc-step" data-step="validate">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="bc-step-body">
                        <span class="bc-step-name">3. Validate</span>
                        <span class="bc-step-note">Checking&hellip;</span>
                    </span>
                </li>
                <li class="bc-step" data-step="deploy">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="bc-step-body">
                        <span class="bc-step-name">4. Deploy</span>
                        <span class="bc-step-note">Checking&hellip;</span>
                    </span>
                </li>
            </ol>
            <p class="bc-wizard-count" role="status"><b id="bc-ready-count">0</b> of 4 ready</p>
        </section>

        <p class="bc-banner" id="bc-page-banner" role="status" aria-live="polite"></p>

        <div class="bc-grid">
            <div class="bc-col">
                <section class="kw-panel cr-reveal" aria-labelledby="bc-library-title">
                    <div class="bc-panel-head">
                        <h2 id="bc-library-title">Profile library</h2>
                        <div class="bc-panel-actions">
                            <button type="button" class="kw-btn cr-press" id="bc-create">
                                <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                                Create profile
                            </button>
                            <button type="button" class="kw-btn cr-press" id="bc-edit" disabled>
                                <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
                                Edit profile
                            </button>
                        </div>
                    </div>

                    <div class="bc-profiles-head" aria-hidden="true">
                        <span></span>
                        <span>Profile name</span>
                        <span>Tone</span>
                        <span>Last updated</span>
                        <span></span>
                    </div>

                    <fieldset class="bc-profiles" id="bc-profiles">
                        <legend class="kw-visually-hidden">Choose the profile this bot answers with</legend>
                    </fieldset>

                    <div class="bc-preview" id="bc-preview"></div>
                </section>
            </div>

            <div class="bc-col" id="bc-setup-details-column">
                <details class="bc-readiness-details" id="bc-setup-details" open>
                <summary class="kw-help" hidden>Review setup details</summary>
                <section class="kw-panel cr-reveal" aria-labelledby="bc-readiness-title">
                    <div class="bc-panel-head">
                        <h2 id="bc-readiness-title">Setup readiness</h2>
                    </div>
                    <ul class="bc-readiness" id="bc-readiness"></ul>
                </section>
                </details>
            </div>
        </div>

        <section class="kw-panel" id="bc-industry-panel" aria-labelledby="bc-industry-title" aria-busy="true">
            <div class="kw-panel-head">
                <h2 class="kw-panel-title" id="bc-industry-title">Industry guidance</h2>
            </div>
            <div class="kw-panel-body">
                <p class="kw-help" id="bc-industry-status" role="status">Loading industry suggestion…</p>
                <p class="kw-help" id="bc-industry-published">Current industry guidance has not been checked.</p>
                <dl class="bc-deflist">
                    <dt>Source document</dt><dd id="bc-industry-source">Not checked</dd>
                    <dt>Why this was suggested</dt><dd><ul id="bc-industry-evidence"></ul></dd>
                </dl>
                <form id="bc-industry-form">
                    <fieldset class="kw-field" id="bc-industry-fields" disabled>
                        <legend class="kw-label">Review the industry template</legend>
                        <label class="kw-label" for="bc-industry-select">Industry</label>
                        <select class="kw-input" id="bc-industry-select" required aria-describedby="bc-industry-description bc-industry-effect">
                            <option value="">Choose an industry</option>
                        </select>
                        <p class="kw-help" id="bc-industry-description"></p>
                        <dl class="bc-deflist" id="bc-industry-details" hidden>
                            <dt>Suggested questions</dt><dd><ul id="bc-industry-questions"></ul></dd>
                            <dt>Check your documents include</dt><dd><ul id="bc-industry-checklist"></ul></dd>
                            <dt>Actions this template cannot perform</dt><dd><ul id="bc-industry-unavailable"></ul></dd>
                        </dl>
                        <p class="kw-help" id="bc-industry-effect">Confirming applies this industry guidance to replies on connected bots immediately. Your profile, custom instructions and channel connections stay as they are.</p>
                        <button type="submit" class="kw-btn kw-btn-primary" id="bc-industry-confirm" disabled>Confirm and apply industry</button>
                    </fieldset>
                </form>
                <button type="button" class="kw-btn" id="bc-industry-change" hidden>Change industry</button>
                <p class="bc-banner bc-banner-error" id="bc-industry-error" role="alert"></p>
                <button type="button" class="kw-btn" id="bc-industry-reload">Reload industry suggestion</button>
            </div>
        </section>

        <!-- Step 3. POST /api/match/check compares the active profile against
             the active primary knowledge. -->
        <section class="kw-panel bc-gate cr-reveal" id="bc-validate-gate" aria-labelledby="bc-validate-title">
            <span class="bc-gate-icon" aria-hidden="true">
                <svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6Z"/></svg>
            </span>
            <div class="bc-gate-body">
                <h2 id="bc-validate-title">Validation checkpoint</h2>
                <p id="bc-validate-copy">Validation checks your active profile against the active primary knowledge to help ensure accurate and reliable responses. It runs on its own when either one changes.</p>
                <p class="bc-gate-reason" id="bc-validate-reason" hidden></p>
            </div>
            <div class="bc-gate-actions">
                <button type="button" class="kw-btn cr-press" id="bc-validate">
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3l7 3v6c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6Z"/></svg>
                    <span id="bc-validate-label">Validate setup</span>
                </button>
                <span class="bc-gate-status" id="bc-validate-status">Not validated yet.</span>
            </div>
        </section>

        <!-- Step 4. PUT /api/settings/apply-profile. The button stays disabled
             until validation passes, so the rule the backend enforces is
             visible before the click rather than only after it. -->
        <section class="kw-panel bc-gate is-locked cr-reveal" id="bc-deploy-gate" aria-labelledby="bc-deploy-title">
            <span class="bc-gate-icon" aria-hidden="true">
                <svg class="dashboard-icon" viewBox="0 0 24 24" id="bc-deploy-icon">
                    <rect x="4" y="11" width="16" height="10" rx="2"/>
                    <path id="bc-deploy-shackle" d="M8 11V7a4 4 0 0 1 8 0v4"/>
                </svg>
            </span>
            <div class="bc-gate-body">
                <h2 id="bc-deploy-title">Deploy to live bot</h2>
                <p id="bc-deploy-copy">Validate setup before deploying.</p>
            </div>
            <div class="bc-gate-actions">
                <button type="button" class="kw-btn kw-btn-primary cr-press" id="bc-deploy" disabled>
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                    Deploy to live bot
                </button>
                <a class="kw-btn cr-press" id="bc-testbot" href="testbot.html">
                    Open Test Bot
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M14 4h6v6"/><path d="M20 4 10 14"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
                </a>
            </div>
        </section>

        <section class="kw-panel bc-setup-next" id="bc-setup-next" hidden aria-labelledby="bc-setup-next-title">
            <h2 id="bc-setup-next-title">Your instructions are applied</h2>
            <p>Try a customer question with these settings. You will choose where customers can reach your bot on the next step.</p>
            <a class="kw-btn kw-btn-primary" id="bc-continue-test" href="testbot.html">Continue to test</a>
        </section>

        <!-- Phone-only mirror of the two gates above. -->
        <div class="bc-actionbar">
            <button type="button" class="kw-btn cr-press" id="bc-validate-mobile">Validate setup</button>
            <button type="button" class="kw-btn kw-btn-primary cr-press" id="bc-deploy-mobile" disabled>Deploy</button>
        </div>
    </main>

    <!-- Profile editor -->
    <div class="kw-backdrop" id="bc-modal" role="dialog" aria-modal="true" aria-labelledby="bc-modal-title">
        <div class="kw-modal kw-modal-wide">
            <div class="kw-modal-head">
                <h2 class="kw-panel-title" id="bc-modal-title">Create profile</h2>
                <button type="button" class="kw-btn kw-btn-icon cr-press" id="bc-modal-close" aria-label="Close">
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div class="kw-modal-body">
                <form class="bc-form" id="bc-form">
                    <p class="bc-banner" id="bc-form-banner" role="status" aria-live="polite"></p>

                    <div class="bc-form-row">
                        <div class="kw-field">
                            <label class="kw-label" for="bc-f-name">Profile name</label>
                            <input class="kw-input" id="bc-f-name" name="profile_name" required
                                autocomplete="off" spellcheck="false" placeholder="Support Specialist&hellip;">
                        </div>
                        <div class="kw-field">
                            <label class="kw-label" for="bc-f-bot">Bot name</label>
                            <input class="kw-input" id="bc-f-bot" name="bot_name" required autocomplete="off"
                                placeholder="Omnexa Assistant&hellip;">
                        </div>
                    </div>

                    <div class="bc-form-row">
                        <div class="kw-field">
                            <label class="kw-label" for="bc-f-company">Company name</label>
                            <input class="kw-input" id="bc-f-company" name="company_name" required autocomplete="organization"
                                placeholder="Omnexa&hellip;">
                        </div>
                        <div class="kw-field">
                            <label class="kw-label" for="bc-f-tone">Tone</label>
                            <!-- Free text with suggestions, not a fixed list. The
                                 column stores arbitrary phrasing ("Clear,
                                 professional") and persona derivation writes it
                                 from documents, so a three-option <select> could
                                 not hold the stored value and blanked it on save. -->
                            <input class="kw-input" id="bc-f-tone" name="tone" list="bc-tone-options" required
                                autocomplete="off" placeholder="Clear, professional&hellip;">
                            <datalist id="bc-tone-options">
                                <option value="Friendly"></option>
                                <option value="Professional"></option>
                                <option value="Formal"></option>
                                <option value="Clear, professional"></option>
                                <option value="Helpful, empathetic"></option>
                            </datalist>
                        </div>
                    </div>

                    <div class="kw-field">
                        <label class="kw-label" for="bc-f-desc">Business description</label>
                        <textarea class="kw-textarea" id="bc-f-desc" name="business_description" rows="3" required
                            placeholder="What your business does and who it serves&hellip;"></textarea>
                    </div>

                    <div class="kw-field">
                        <label class="kw-label" for="bc-f-extra">Additional instructions</label>
                        <textarea class="kw-textarea" id="bc-f-extra" name="additional_instructions" rows="3"
                            placeholder="Always be accurate and concise&hellip;"></textarea>
                    </div>

                    <details class="kw-advanced" id="bc-prompt-options">
                        <summary>Advanced: custom prompt override
                            <svg class="dashboard-icon kw-advanced-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                        </summary>
                        <div class="kw-advanced-body">
                            <div class="kw-field kw-wide">
                                <label class="kw-label" for="bc-f-prompt">Custom prompt template</label>
                                <textarea class="kw-textarea" id="bc-f-prompt" name="custom_prompt" rows="4"
                                    placeholder="Optional. Overrides the generated system prompt&hellip;"></textarea>
                            </div>
                        </div>
                    </details>
                </form>
            </div>
            <div class="kw-modal-foot">
                <button type="button" class="kw-btn kw-btn-danger cr-press" id="bc-delete" hidden>Delete profile</button>
                <button type="button" class="kw-btn cr-press" id="bc-cancel">Cancel</button>
                <button type="submit" form="bc-form" class="kw-btn kw-btn-primary cr-press" id="bc-save">Save profile</button>
            </div>
        </div>
    </div>

    <!-- Delete confirmation. Destructive, so it is confirmed, never immediate. -->
    <div class="kw-backdrop" id="bc-confirm" role="dialog" aria-modal="true" aria-labelledby="bc-confirm-title">
        <div class="kw-modal kw-modal-narrow">
            <div class="kw-modal-head">
                <h2 class="kw-panel-title" id="bc-confirm-title">Delete profile?</h2>
            </div>
            <div class="kw-modal-body">
                <p class="kw-desc" id="bc-confirm-copy"></p>
            </div>
            <div class="kw-modal-foot">
                <button type="button" class="kw-btn cr-press" id="bc-confirm-cancel">Cancel</button>
                <button type="button" class="kw-btn kw-btn-danger cr-press" id="bc-confirm-delete">Delete</button>
            </div>
        </div>
    </div>

    <Fragment slot="end">
    <script is:inline src="assets/js/new_prompt.js"></script>
    </Fragment>
</AppLayout>
