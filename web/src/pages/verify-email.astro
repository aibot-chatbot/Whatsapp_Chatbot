<!DOCTYPE html>
<html lang="en">
<head>
    <script is:inline src="assets/js/theme-boot.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Check your email | Omnexa</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <meta name="description" content="Enter the six digit code we sent to confirm your Omnexa account.">
    <meta name="robots" content="noindex,follow">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Geist:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/auth-volleo.css">
    <link rel="stylesheet" href="assets/css/app-preferences.css">
    <script is:inline defer src="assets/js/app-preferences.js"></script>
</head>
<body>
    <div class="auth-shell">
        <main class="auth-main">
            <div class="auth-card">
                <a class="auth-brand" href="landing.html"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 4.2h9.8l-3.1 4H3.9z" fill="currentColor"/><path d="M5.5 10h9.8l-3.1 4H2.4z" fill="currentColor"/><path d="M4 15.8h9.8l-3.1 4H0.9z" fill="currentColor"/></svg> Omnexa</a>

                <div class="auth-head">
                    <h1>Check your email</h1>
                    <p>We sent a six digit code to <strong id="user-email">...</strong>. It expires in 10 minutes.</p>
                </div>

                <form id="otp-form" aria-describedby="general-message">
                    <div class="input-group">
                        <label for="otp-code">Verification code</label>
                        <div class="otp-inputs">
                            <input type="text" id="otp-code" placeholder="000000" required autocomplete="one-time-code" inputmode="numeric" pattern={"[0-9]{6}"} maxlength="6" aria-describedby="general-message">
                        </div>
                    </div>

                    <div id="general-message" class="login-error" role="alert" aria-live="assertive" aria-atomic="true" style="display: none; border: 1px solid transparent;"></div>

                    <button type="submit" class="btn-auth" id="verify-btn">Verify</button>
                </form>

                <p class="resend-box" is:raw>
                    Did not get it?
                    <button type="button" id="resend-link" onclick="resendOTP()">Resend code</button> <span id="timer"></span>
                </p>

                <p class="auth-meta"><span>Secure Omnexa auth</span> <span class="auth-meta-ok">TLS 1.3 encrypted</span></p>
            </div>
        </main>
        <aside class="auth-aside">
            <div class="auth-aurora" aria-hidden="true">
                <span class="auth-aurora-orb auth-aurora-orb--primary"></span>
                <span class="auth-aurora-orb auth-aurora-orb--secondary"></span>
                <span class="auth-aurora-orb auth-aurora-orb--core"></span>
            </div>
            <div class="auth-stage">
                <div class="auth-halo" aria-hidden="true"></div>
                <img class="auth-visual" src="https://manertvcpqtsmegqvhuc.supabase.co/storage/v1/object/public/landing/img/v2/auth-code.webp" alt="" aria-hidden="true" decoding="async" width="1024" height="1280">
            </div>
        </aside>
    </div>

    <script is:inline src="assets/js/auth-sentry.js"></script>
    <script is:inline src="assets/js/verify-email.js"></script>
</body>
</html>