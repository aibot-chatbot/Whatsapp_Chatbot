---
// GEO Analysis on the shared tenant frame (F4), moved like-for-like from frontend/geo-analysis.html.
// Its two inline scripts are theme-boot.js and require-login.js, which AppLayout loads; this page
// adds its stylesheet, its content and its own deferred script.
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="GEO Analysis | Omnexa">
    <Fragment slot="head">
    <link rel="stylesheet" href="assets/css/geo-analysis.css">
    </Fragment>

    <main class="main-container kw-page geo-page">
        <header class="kw-header geo-header">
            <div><span class="geo-eyebrow">AI search visibility</span><h1>See how AI describes your brand</h1><p class="kw-header-sub">Enter the search topics your customers use, compare official AI-search evidence, and trace every result back to its source.</p></div>
            <div class="geo-header-actions"><a class="kw-btn geo-compare-link" href="geo-provider-comparison.html"><i data-lucide="split" aria-hidden="true"></i> Compare API routes</a><span class="geo-plan-pill" id="geo-plan-pill">Checking plan…</span></div>
        </header>
        <div class="kw-banner" id="geo-banner" role="status" hidden><span id="geo-banner-text"></span><button class="kw-btn" id="geo-retry" type="button">Reload</button></div>
        <section class="kw-locked" id="geo-locked" hidden aria-labelledby="geo-locked-title">
            <span class="kw-locked-icon" aria-hidden="true"><i data-lucide="lock-keyhole"></i></span>
            <div><h2 id="geo-locked-title">GEO Analysis is available on paid plans</h2><p>Upgrade to Essential, Advanced or Pro to measure your visibility across supported AI search APIs.</p><a class="kw-btn kw-btn-primary" href="pricing.html">See plans</a></div>
        </section>
        <div class="geo-layout" id="geo-workspace" hidden>
            <section class="kw-panel geo-form-panel" aria-labelledby="geo-new-title">
                <div class="kw-panel-head geo-builder-head"><div><span class="geo-kicker">New analysis</span><h2 class="kw-panel-title" id="geo-new-title">Build your visibility scan</h2><p class="kw-help">Complete the three steps below. Most scans take less than two minutes.</p></div><span class="geo-live-badge"><i></i> Live sources</span></div>
                <form class="kw-panel-body geo-form" id="geo-form" novalidate>
                    <section class="geo-builder-section" aria-labelledby="geo-target-title">
                        <div class="geo-step"><span>1</span><div><strong id="geo-target-title">Set your target</strong><small>Tell us which brand and market to look for.</small></div></div>
                        <div class="geo-field-grid geo-target-grid">
                            <label class="geo-field geo-brand-field"><span>Brand name <em>Required</em></span><input id="geo-brand" maxlength="120" required placeholder="e.g. Omnexa" autocomplete="organization"></label>
                            <label class="geo-field"><span>Country</span><input id="geo-country" maxlength="2" value="MY" required aria-describedby="geo-country-help"><small id="geo-country-help">Two-letter code, such as MY or SG.</small></label>
                            <label class="geo-field"><span>Answer language</span><select id="geo-language"><option value="en">English</option><option value="ms">Bahasa Melayu</option><option value="zh">简体中文</option></select></label>
                            <label class="geo-field geo-span"><span>Your website domains</span><input id="geo-domains" maxlength="2000" placeholder="omnexa.my, app.omnexa.my"><small>We use these to identify citations that belong to you.</small></label>
                        </div>
                        <details class="geo-advanced">
                            <summary><span><i data-lucide="sliders-horizontal" aria-hidden="true"></i> Improve brand matching</span><small>Optional</small></summary>
                            <div class="geo-field-grid geo-advanced-fields">
                                <label class="geo-field"><span>Other brand names</span><input id="geo-aliases" maxlength="1000" placeholder="Omnexa AI, Omnexa Malaysia"><small>Separate aliases with commas.</small></label>
                                <label class="geo-field"><span>Competitors to compare</span><input id="geo-competitors" maxlength="1000" placeholder="Competitor A, Competitor B"><small>Add 2–5 exact competitor names to improve rank detection when the answer does not contain a numbered list.</small></label>
                            </div>
                        </details>
                    </section>

                    <section class="geo-builder-section" aria-labelledby="geo-model-title">
                        <div class="geo-step"><span>2</span><div><strong id="geo-model-title">Choose AI search models</strong><small>Every ready model is selected. Uncheck one to spend fewer provider checks.</small></div></div>
                        <fieldset class="geo-platforms"><legend>AI search models</legend>
                            <label class="geo-model-card geo-model-openai" data-platform-row="chatgpt">
                                <input type="checkbox" name="geo-platform" value="chatgpt" aria-label="Select ChatGPT Search">
                                <span class="geo-model-logo" aria-hidden="true"><svg viewBox="0 0 32 32" role="img"><g fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><ellipse cx="16" cy="9.2" rx="5.4" ry="7.2" transform="rotate(0 16 16)"/><ellipse cx="16" cy="9.2" rx="5.4" ry="7.2" transform="rotate(60 16 16)"/><ellipse cx="16" cy="9.2" rx="5.4" ry="7.2" transform="rotate(120 16 16)"/></g></svg></span>
                                <span class="geo-model-copy"><b>ChatGPT Search</b><small>OpenAI · live web search</small></span>
                                <em data-provider="chatgpt"></em>
                                <span class="geo-model-check" aria-hidden="true">✓</span>
                            </label>
                            <label class="geo-model-card geo-model-gemini" data-platform-row="gemini">
                                <input type="checkbox" name="geo-platform" value="gemini" aria-label="Select Gemini">
                                <span class="geo-model-logo" aria-hidden="true"><svg viewBox="0 0 32 32" role="img"><defs><linearGradient id="gemini-mark" x1="4" y1="28" x2="28" y2="4"><stop stop-color="#4f8cff"/><stop offset=".52" stop-color="#a06cff"/><stop offset="1" stop-color="#ff65ad"/></linearGradient></defs><path fill="url(#gemini-mark)" d="M16 2.8C16.9 10.4 21.6 15.1 29.2 16 21.6 16.9 16.9 21.6 16 29.2 15.1 21.6 10.4 16.9 2.8 16 10.4 15.1 15.1 10.4 16 2.8Z"/></svg></span>
                                <span class="geo-model-copy"><b>Gemini</b><small>Google · grounded search</small></span>
                                <em data-provider="gemini"></em>
                                <span class="geo-model-check" aria-hidden="true">✓</span>
                            </label>
                            <label class="geo-model-card geo-model-claude" data-platform-row="claude">
                                <input type="checkbox" name="geo-platform" value="claude" aria-label="Select Claude">
                                <span class="geo-model-logo" aria-hidden="true"><svg viewBox="0 0 32 32" role="img"><path fill="currentColor" d="M14.3 4.5h3.4l.6 7.1 6.2-3.6 1.7 3-5.7 4 5.7 4-1.7 3-6.2-3.6-.6 7.1h-3.4l-.6-7.1L7.5 22l-1.7-3 5.7-4-5.7-4 1.7-3 6.2 3.6.6-7.1Z"/></svg></span>
                                <span class="geo-model-copy"><b>Claude</b><small>Anthropic · native web search</small></span>
                                <em data-provider="claude"></em>
                                <span class="geo-model-check" aria-hidden="true">✓</span>
                            </label>
                            <label class="geo-model-card geo-model-deepseek" data-platform-row="deepseek">
                                <input type="checkbox" name="geo-platform" value="deepseek" aria-label="Select DeepSeek">
                                <span class="geo-model-logo" aria-hidden="true"><svg viewBox="0 0 32 32" role="img"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 18c3.3 4.9 8 7.3 13.9 6.9 4.7-.3 8-2.8 9.7-7.6-2.4 1.2-4.8 1.4-7.3.7 1.1-1.1 1.8-2.5 2.1-4.1-2.1.8-4.1.7-6-.3-1.8-.9-3.3-2.5-4.6-4.8-.8 4.2-3.4 7.2-7.8 9.2Zm16.1-7.3c1.9-1.8 4-2 6.3-.6-1.3 2.1-3.3 2.8-6.3 2.2"/></svg></span>
                                <span class="geo-model-copy"><b>DeepSeek</b><small>Official · web-search route</small></span>
                                <em data-provider="deepseek"></em>
                                <span class="geo-model-check" aria-hidden="true">✓</span>
                            </label>
                            <label class="geo-model-card geo-model-perplexity" data-platform-row="perplexity">
                                <input type="checkbox" name="geo-platform" value="perplexity" aria-label="Select Perplexity">
                                <span class="geo-model-logo" aria-hidden="true"><svg viewBox="0 0 32 32" role="img"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M8 9.5h16v15H8zM8 9.5 16 4l8 5.5M16 4v24M8 9.5l8 7 8-7M8 24.5l8-8 8 8M5 13h3M24 13h3"/></g></svg></span>
                                <span class="geo-model-copy"><b>Perplexity</b><small>Official Agent API · web search</small></span>
                                <em data-provider="perplexity"></em>
                                <span class="geo-model-check" aria-hidden="true">✓</span>
                            </label>
                        </fieldset>
                    </section>

                    <section class="geo-builder-section" aria-labelledby="geo-keywords-title">
                        <div class="geo-step"><span>3</span><div><strong id="geo-keywords-title">Add buyer keywords</strong><small>Each keyword becomes one natural buyer question and one independent measurement per selected model.</small></div></div>
                        <div class="geo-field geo-keyword-field">
                            <span><label for="geo-keyword-input">Search keywords</label><b class="geo-counter" id="geo-keyword-counter">0 / 10</b></span>
                            <div class="geo-keyword-box" id="geo-keyword-box">
                                <div class="geo-keyword-list" id="geo-keyword-list" role="list" aria-label="Added search keywords"></div>
                                <input id="geo-keyword-input" type="text" maxlength="80" autocomplete="off" enterkeyhint="done" aria-describedby="geo-keyword-help geo-keyword-error" placeholder="Type a keyword and press Enter">
                            </div>
                            <small id="geo-keyword-help">Add up to 10 unbranded category or buyer-intent keywords. Press Enter or comma after each keyword.</small>
                            <small class="geo-keyword-error" id="geo-keyword-error" role="alert" hidden></small>
                        </div>
                        <div class="geo-prompt-examples" aria-label="Keyword examples"><span>Try an example:</span><button type="button" data-keyword-example="AI chatbot Malaysia">AI chatbot Malaysia</button><button type="button" data-keyword-example="WhatsApp automation">WhatsApp automation</button><button type="button" data-keyword-example="customer service AI">Customer service AI</button></div>
                    </section>

                    <div class="geo-submit-row"><div><strong id="geo-run-equation">Choose a model and add keywords</strong><p class="kw-help" id="geo-cost-preview">We will show the exact provider-check cost before you run.</p></div><button class="kw-btn kw-btn-primary geo-run-button" id="geo-submit" type="submit"><span>Run GEO analysis</span><i data-lucide="arrow-right" aria-hidden="true"></i></button></div>
                </form>
            </section>
            <aside class="geo-rail">
                <section class="kw-panel geo-budget-panel" aria-labelledby="geo-budget-title">
                    <div class="geo-allowance" aria-label="Monthly GEO allowance">
                        <div class="geo-allowance-head"><span id="geo-budget-title">Monthly scan budget</span><strong id="geo-usage-label">—</strong></div>
                        <div class="geo-usage-track"><span id="geo-usage-bar"></span></div>
                        <small id="geo-usage-reset">Loading allowance…</small>
                    </div>
                    <div class="geo-cost-guide"><strong>How checks are counted</strong><p>Buyer questions × selected live APIs = provider checks.</p><span>Each keyword creates one independent buyer question, so the mention rate can show meaningful middle values.</span></div>
                </section>
                <section class="kw-panel geo-monitoring-panel" aria-labelledby="geo-monitoring-title">
                    <div class="kw-panel-head"><div><h2 class="kw-panel-title" id="geo-monitoring-title">Scheduled monitoring</h2><p class="kw-help">Rerun the same question panel automatically for a trustworthy trend.</p></div><span class="geo-monitoring-state" id="geo-monitoring-state">Loading…</span></div>
                    <form class="kw-panel-body geo-monitoring-form" id="geo-monitoring-form">
                        <label class="geo-monitoring-toggle"><input id="geo-monitoring-enabled" type="checkbox"><span><strong>Enable monitoring</strong><small>Uses your monthly provider-check allowance.</small></span></label>
                        <label class="geo-field"><span>Frequency</span><select id="geo-monitoring-frequency"><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></label>
                        <label class="geo-field" id="geo-monitoring-weekday-field"><span>Run on</span><select id="geo-monitoring-weekday"><option value="0">Monday</option><option value="1">Tuesday</option><option value="2">Wednesday</option><option value="3">Thursday</option><option value="4">Friday</option><option value="5">Saturday</option><option value="6">Sunday</option></select></label>
                        <label class="geo-field" id="geo-monitoring-day-field" hidden><span>Day of month</span><input id="geo-monitoring-day" type="number" min="1" max="28" value="1"></label>
                        <label class="geo-field"><span>Time (Malaysia)</span><input id="geo-monitoring-time" type="time" step="900" value="09:00"></label>
                        <p class="kw-help" id="geo-monitoring-next">Save the current brand, keywords and selected models as the monitoring panel.</p>
                        <button class="kw-btn" id="geo-monitoring-save" type="submit">Save monitoring</button>
                    </form>
                </section>
                <section class="kw-panel geo-history-panel" aria-labelledby="geo-history-title">
                    <div class="kw-panel-head"><div><h2 class="kw-panel-title" id="geo-history-title">Recent analyses</h2><p class="kw-help">Results shared with your workspace</p></div></div>
                    <div class="kw-panel-body geo-history" id="geo-history"><p class="kw-help">Loading analyses…</p></div>
                </section>
            </aside>
        </div>
        <section class="kw-panel geo-results" id="geo-results" hidden aria-labelledby="geo-results-title">
            <div class="kw-panel-head"><div><h2 class="kw-panel-title" id="geo-results-title">Brand mention performance</h2><p class="kw-help" id="geo-result-context"></p></div><span class="geo-status" id="geo-result-status"></span></div>
            <div class="kw-panel-body">
                <div class="geo-metrics" id="geo-metrics"></div>
                <section class="geo-platform-summary" aria-labelledby="geo-platform-summary-title"><h3 id="geo-platform-summary-title">Mention score and rank by platform</h3><div id="geo-platform-summary"></div></section>
                <section class="geo-findings" aria-labelledby="geo-findings-title"><div class="geo-section-heading"><h3 id="geo-findings-title">Evidence-based improvement plan</h3><span>Prompt, competitor and source evidence</span></div><div id="geo-findings"></div></section>
                <div class="geo-method" id="geo-method"></div>
                <h3 class="geo-evidence-title">Mention evidence by buyer question and platform</h3>
                <div class="geo-matrix-wrap"><table class="geo-matrix"><thead id="geo-matrix-head"></thead><tbody id="geo-matrix-body"></tbody></table></div>
                <details class="geo-raw-evidence"><summary>Open complete provider responses</summary><div class="geo-evidence" id="geo-evidence"></div></details>
            </div>
        </section>
    </main>

    <Fragment slot="end">
    <script is:inline src="assets/js/geo-analysis.js" defer></script>
    </Fragment>
</AppLayout>
