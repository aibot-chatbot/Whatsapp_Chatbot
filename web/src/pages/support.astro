---
// Support on the shared tenant frame (F4), moved like-for-like from frontend/support.html.
// AppLayout supplies the theme and login boot scripts; support.js keeps the page logic verbatim.
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Support | Omnexa">
    <Fragment slot="head">
    <link rel="stylesheet" href="assets/css/support.css">
    </Fragment>


    <main class="main-container kw-page">
        <header class="kw-header">
            <div>
                <h1>Support</h1>
                <p class="kw-header-sub">Search the help centre first. If nothing here solves it, hand the problem to a person.</p>
            </div>
            <!-- Standing offer, deliberately quiet: self-service gets first
                 refusal. It only becomes the loud option when the article
                 fetch fails, where the error card promotes it. -->
            <button class="human-link cr-press" id="sup-open-escalation" type="button">
                <svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                Talk to a human
            </button>
        </header>

        <!-- ── 2. Search hero ──────────────────────────────────────────── -->
        <section class="cr-reveal" aria-labelledby="sup-search-heading">
            <h2 class="kw-visually-hidden" id="sup-search-heading">Search the help centre</h2>

            <div class="search-field">
                <svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m20 20-3.6-3.6" />
                </svg>
                <input id="sup-query" type="search" autocomplete="off"
                       aria-describedby="sup-result-count"
                       placeholder="Search help articles &mdash; try &ldquo;credits&rdquo; or &ldquo;telegram&rdquo;">
            </div>

            <div class="chips" id="sup-chips" role="group" aria-label="Filter articles by category">
                <button class="chip" data-cat="all" aria-pressed="true" type="button">All</button>
                <button class="chip" data-cat="chatbot" aria-pressed="false" type="button">Chatbot</button>
                <button class="chip" data-cat="integration" aria-pressed="false" type="button">Integration</button>
                <button class="chip" data-cat="billing_question" aria-pressed="false" type="button">Billing</button>
                <button class="chip" data-cat="ai_credits" aria-pressed="false" type="button">AI credits</button>
                <button class="chip" data-cat="account" aria-pressed="false" type="button">Account</button>
                <button class="chip" data-cat="technical" aria-pressed="false" type="button">Technical</button>
                <button class="chip" data-cat="other" aria-pressed="false" type="button">Other</button>
            </div>

            <!-- Destinations, not filters. Squared corners and a trailing
                 arrow keep them visually separate from the pill chips above,
                 which toggle rather than navigate. -->
            <div class="sup-jump">
                <span class="eyebrow" id="sup-jump-label">Or open a page directly</span>
                <nav class="quick-links" aria-labelledby="sup-jump-label">
                    <a class="quick-link" href="bots.html" data-support-link>My Bots<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="profile.html" data-support-link>Profile<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="team.html" data-support-link>Team Members<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="pricing.html" data-support-link>Billing<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="integration.html" data-support-link>Integrations<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="new_linkdocs.html" data-support-link>Documents<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="model_settings.html" data-support-link>Tune AI<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="conversations.html" data-support-link>Inbox &amp; Chat<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                    <a class="quick-link" href="crm.html" data-support-link>CRM &amp; Leads<svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
                </nav>
            </div>
        </section>

        <!-- ── 3. Results: list, then reader ───────────────────────────── -->
        <section class="cr-reveal" aria-labelledby="sup-articles-heading">
            <div class="sec-head">
                <span class="eyebrow" id="sup-articles-heading">Help articles</span>
                <span class="count" id="sup-result-count" aria-live="polite">Loading</span>
            </div>

            <!-- Holds the height four rows will occupy, so the layout does
                 not jump when the fetch lands. Hidden from assistive tech:
                 the live count above already says "Loading". -->
            <div class="skel" id="sup-skeleton" aria-hidden="true">
                <div class="skel-row cr-skeleton"></div>
                <div class="skel-row cr-skeleton"></div>
                <div class="skel-row cr-skeleton"></div>
                <div class="skel-row cr-skeleton"></div>
            </div>

            <div class="errbox" id="sup-articles-error" hidden>
                <h3>Help articles could not be loaded</h3>
                <p>The connection to the help centre failed. Your support history and the option to contact a person both still work.</p>
                <div class="esc-actions">
                    <button class="kw-btn cr-press" id="sup-retry-articles" type="button">Try again</button>
                    <button class="kw-btn kw-btn-primary cr-press" id="sup-error-escalate" type="button">Talk to a human instead</button>
                </div>
            </div>

            <div class="articles" id="sup-article-list" hidden></div>

            <div class="reader" id="sup-reader" hidden>
                <div class="reader-top">
                    <button class="back" id="sup-reader-back" type="button">
                        <svg class="dashboard-icon" viewBox="0 0 24 24" aria-hidden="true" style="width:12px;height:12px"><path d="M19 12H5m6 6-6-6 6-6" /></svg>
                        All articles
                    </button>
                    <h2 id="sup-reader-title" tabindex="-1"></h2>
                </div>
                <div class="reader-body" id="sup-reader-body"></div>
                <div class="vote" id="sup-vote" aria-live="polite"></div>
            </div>
        </section>

        <!-- ── 4. Dead end: below the article, never over it ───────────── -->
        <section class="cr-reveal" id="sup-deadend" hidden aria-labelledby="sup-deadend-title">
            <div class="deadend">
                <h3 id="sup-deadend-title" tabindex="-1">Still stuck? Hand it to a person.</h3>
                <p id="sup-deadend-why">Nothing in the help centre matched. A member of the support team can pick this up.</p>
                <div class="esc-actions">
                    <button class="kw-btn kw-btn-primary cr-press" id="sup-deadend-escalate" type="button">Get help from a person</button>
                    <button class="kw-btn cr-press" id="sup-keep-looking" type="button">Keep looking</button>
                </div>
            </div>
        </section>

        <!-- ── 5. Escalation ──────────────────────────────────────────── -->
        <section class="cr-reveal" id="sup-escalation" hidden aria-labelledby="sup-escalation-title">
            <div class="esc">
                <div class="esc-head">
                    <h3 id="sup-escalation-title" tabindex="-1">Contact the support team</h3>
                    <p>Describe the problem and what you have already tried.</p>
                </div>

                <div class="trail">
                    <div class="trail-h">Your account</div>
                    <div class="trail-row"><span class="trail-k">Account</span><span class="trail-v" id="sup-trail-account">Signed in</span></div>
                    <div class="trail-row"><span class="trail-k">Email</span><span class="trail-v" id="sup-trail-email">Account details unavailable</span></div>
                </div>

                <form class="fields" id="support-request-form" novalidate>
                    <div class="kw-field">
                        <label class="kw-label" for="sup-category">Category</label>
                        <select class="kw-select" id="sup-category" name="category" required>
                            <option value="technical">Technical</option>
                            <option value="account">Account</option>
                            <option value="chatbot">Chatbot</option>
                            <option value="integration">Integration</option>
                            <option value="billing_question">Billing question</option>
                            <option value="ai_credits">AI credits</option>
                            <option value="other" selected>Other</option>
                        </select>
                    </div>

                    <div class="kw-field">
                        <label class="kw-label" for="sup-subject">Subject</label>
                        <input class="kw-input" id="sup-subject" name="title" type="text" maxlength="160" required>
                    </div>

                    <div class="kw-field">
                        <label class="kw-label" for="sup-description">What is happening?</label>
                        <textarea class="kw-textarea" id="sup-description" name="redacted_description" rows="5" maxlength="1600" required></textarea>
                    </div>

                    <p class="warn-note">Do not include passwords, tokens, cookies, payment details, provider payloads, or private customer conversation content.</p>

                    <div class="esc-actions">
                        <button class="kw-btn kw-btn-primary cr-press" id="sup-submit" type="submit">Send to support</button>
                        <button class="kw-btn cr-press" id="sup-cancel" type="button">Cancel</button>
                    </div>
                    <p class="esc-status" id="sup-escalation-status" role="status" aria-live="polite"></p>
                </form>
            </div>
        </section>

        <!-- ── 6. Support history ─────────────────────────────────────── -->
        <section class="cr-reveal" aria-labelledby="sup-history-heading">
            <div class="sec-head">
                <span class="eyebrow" id="sup-history-heading">Support History</span>
                <span class="count" id="sup-history-count" aria-live="polite">Loading</span>
            </div>

            <div class="empty" id="sup-history-empty" hidden>
                <h3>No support requests yet</h3>
                <p>When you send something to the support team it appears here, along with any reply they write back.</p>
            </div>

            <div class="hist" id="sup-history">
                <div class="hist-list" id="support-history-list" aria-live="polite">Loading support requests...</div>
                <div class="hist-detail" id="support-history-detail" aria-live="polite">Select a request to view its conversation.</div>
            </div>
        </section>

        <!-- ── 7. Footer note: the boundary, stated plainly ────────────── -->
        <p class="foot-note">
            Tenant-visible replies only. Email sending, attachments, billing actions, and
            internal notes are not exposed. Requests are submitted for internal review.
        </p>
    </main>

    <Fragment slot="end">
    <script is:inline src="assets/js/support.js"></script>
    </Fragment>
</AppLayout>
