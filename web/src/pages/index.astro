---
// Dashboard on the shared tenant frame (F5); index.js keeps the page logic verbatim.
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Dashboard | Omnexa">
    <Fragment slot="head">
    <link rel="stylesheet" href="assets/css/dashboard-overview.css">
    <link rel="stylesheet" href="assets/css/bot-setup-journey.css">
    <script is:inline src="assets/js/bot-setup-journey.js" defer></script>
    <link rel="stylesheet" href="assets/css/product-tour.css">
    <script is:inline src="assets/js/product-tour.js" defer></script>
    </Fragment>

    <main class="main-container">
        <header class="header cr-reveal">
            <div class="dashboard-heading">
                <a class="dashboard-back-link" href="bots.html">
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m12 19-7-7 7-7M5 12h14"/></svg>
                    My bots
                </a>
                <h1 id="dashboard-title">Overview</h1>
                <p class="dash-statusline" role="status">
                    <span class="dash-live is-idle" id="dash-live">
                        <span class="cr-live-dot is-idle" id="dash-live-dot" aria-hidden="true"></span>
                        <span id="dash-live-label">Checking…</span>
                    </span>
                    <span class="dash-sep" aria-hidden="true"></span>
                    <span id="dash-systems">Loading the selected bot's setup and usage overview…</span>
                    <span class="dash-sep" aria-hidden="true"></span>
                    <span>Last updated: <time class="kw-mono" id="date-display">--</time></span>
                </p>
            </div>
            <div class="dash-menu" id="dash-menu">
                <button type="button" class="kw-btn dash-menu-trigger" id="dash-menu-trigger"
                    aria-expanded="false" aria-haspopup="true" aria-controls="dash-menu-list">
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
                    Bot settings
                    <svg class="dashboard-icon dash-menu-chevron" aria-hidden="true" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="dash-menu-list" id="dash-menu-list" hidden>
                    <a href="new_prompt.html" data-dashboard-link data-manage-only="true">
                        <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h10M18 18h2"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="16" cy="18" r="2"/></svg>
                        Bot instructions
                    </a>
                    <a href="new_linkdocs.html" data-dashboard-link data-manage-only="true">
                        <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h13a3 3 0 0 1 3 3v11H7a3 3 0 0 0-3 3V5Z"/><path d="M7 19h13M8 9h8M8 13h6"/></svg>
                        Add knowledge
                    </a>
                    <a href="model_settings.html" data-dashboard-link data-manage-only="true">
                        <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></svg>
                        Behaviour &amp; model
                    </a>
                    <a href="integration.html" data-dashboard-link>
                        <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
                        Publish
                    </a>
                    <a href="testbot.html" data-dashboard-link data-manage-only="true">
                        <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M9 3h6M10 3v6l-5 8a3 3 0 0 0 2.6 4.5h8.8A3 3 0 0 0 19 17l-5-8V3M8 15h8"/></svg>
                        Test a reply
                    </a>
                </div>
            </div>
        </header>

        <bot-setup-journey id="dashboard-setup-journey" hidden></bot-setup-journey>
        <section class="kw-panel dash-setup cr-reveal" aria-labelledby="dash-setup-title">
            <h2 class="kw-visually-hidden" id="dash-setup-title">Bot setup progress</h2>
            <details id="dash-readiness" class="dash-readiness" open>
            <summary>Setup checks</summary>
            <ol class="dash-steps" id="dash-steps">
                <li class="dash-step" data-step="knowledge">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="dash-step-body">
                        <span class="dash-step-name">Knowledge</span>
                        <span class="dash-step-state">Checking…</span>
                        <span class="dash-step-hint">Add a primary PDF for your bot to learn from</span>
                    </span>
                </li>
                <li class="dash-step" data-step="profile">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="dash-step-body">
                        <span class="dash-step-name">Instructions</span>
                        <span class="dash-step-state">Checking…</span>
                        <span class="dash-step-hint">Review and apply your bot instructions</span>
                    </span>
                </li>
                <li class="dash-step" data-step="validate">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="dash-step-body">
                        <span class="dash-step-name">Content check</span>
                        <span class="dash-step-state">Checking…</span>
                        <span class="dash-step-hint">Check that the instructions match the PDF</span>
                    </span>
                </li>
                <li class="dash-step" data-step="channel">
                    <span class="kw-step-mark" aria-hidden="true"></span>
                    <span class="dash-step-body">
                        <span class="dash-step-name">Publishing</span>
                        <span class="dash-step-state">Checking…</span>
                        <span class="dash-step-hint">Connect a channel to reach customers</span>
                    </span>
                </li>
            </ol>
            </details>
            <div class="dash-nextstep">
                <span class="dash-nextstep-label">Next step</span>
                <h2 id="dash-next-title">Checking setup…</h2>
                <p id="dash-next-copy">Reading this bot's profile, knowledge, validation and channels.</p>
                <a class="kw-btn kw-btn-primary cr-press" id="dash-next-cta" href="new_linkdocs.html" data-dashboard-link hidden>
                    <span id="dash-next-cta-label">Open knowledge</span>
                    <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                </a>
            </div>
        </section>

        <details class="dash-monitoring" id="dash-monitoring" open>
        <summary>Activity and reports <span>View messages, usage, and recent conversations</span></summary>
        <section class="kw-stats dash-stats cr-reveal" aria-label="Bot totals">
            <div class="kw-stat">
                <div class="kw-stat-head">
                    <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg></span>
                    <span class="kw-stat-label">Total users</span>
                </div>
                <div class="kw-stat-value" id="stat-total-users">—</div>
                <div class="kw-stat-unit">Unique contacts</div>
            </div>
            <div class="kw-stat">
                <div class="kw-stat-head">
                    <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4V5Z"/><path d="M8 9h8M8 12h5"/></svg></span>
                    <span class="kw-stat-label">Total messages</span>
                </div>
                <div class="kw-stat-value" id="stat-total-msgs">—</div>
                <div class="kw-stat-unit">Overall interactions</div>
            </div>
            <div class="kw-stat">
                <div class="kw-stat-head">
                    <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                    <span class="kw-stat-label">Active profile</span>
                </div>
                <div class="kw-stat-value is-text" id="stat-active-profile">—</div>
            </div>
            <div class="kw-stat">
                <div class="kw-stat-head">
                    <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M4 5h6a3 3 0 0 1 3 3v11a2 2 0 0 0-2-2H4Z"/><path d="M20 5h-6a3 3 0 0 0-3 3v11a2 2 0 0 1 2-2h7Z"/></svg></span>
                    <span class="kw-stat-label">Active knowledge</span>
                </div>
                <div class="kw-stat-value is-text" id="stat-active-pdf">—</div>
            </div>
            <div class="kw-stat">
                <div class="kw-stat-head">
                    <span class="kw-stat-icon" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
                    <span class="kw-stat-label">Waiting for human</span>
                </div>
                <div class="kw-stat-value" id="stat-waiting-human" aria-live="polite">—</div>
                <div class="kw-stat-unit">
                    <a href="conversations.html?awaiting=1" id="stat-waiting-link" data-dashboard-link hidden>Open queue</a>
                    <span id="stat-waiting-note">—</span>
                </div>
            </div>
        </section>

        <div class="dash-grid">
            <section class="kw-panel cr-reveal" aria-labelledby="dash-trend-title">
                <div class="dash-panel-head">
                    <h2 id="dash-trend-title">Message trend</h2>
                    <label class="kw-visually-hidden" for="dash-range">Trend range</label>
                    <select class="kw-select" id="dash-range">
                        <option value="7" selected>Last 7 days</option>
                    </select>
                </div>
                <div class="dash-panel-body">
                    <div id="chart-container"></div>
                    <div class="dash-chart-labels" id="chart-labels"></div>

                    <div class="dash-daystep">
                        <button type="button" class="kw-btn kw-btn-icon cr-press" id="dash-day-prev" aria-label="Previous day">
                            <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
                        </button>
                        <p class="dash-daystep-read" role="status">
                            <span id="dash-day-label">--</span>
                            <strong id="dash-day-value">--</strong>
                            <span>messages</span>
                        </p>
                        <button type="button" class="kw-btn kw-btn-icon cr-press" id="dash-day-next" aria-label="Next day">
                            <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg>
                        </button>
                    </div>

                    <dl class="dash-chart-foot">
                        <div class="dash-chart-figure">
                            <dt>Total (last 7 days)</dt>
                            <dd id="dash-trend-total">--</dd>
                        </div>
                        <div class="dash-chart-figure">
                            <dt>Peak day</dt>
                            <dd id="dash-trend-peak">--</dd>
                        </div>
                    </dl>
                </div>
            </section>

            <div class="dash-col">
                <section class="kw-panel cr-reveal" aria-labelledby="dash-flow-title">
                    <div class="dash-panel-head">
                        <h2 id="dash-flow-title">Live AI workflow</h2>
                        <p class="dash-flow-legend" id="workflow-status-badge" role="status">
                            <span class="is-on"><span class="cr-live-dot is-idle" id="dash-flow-dot" aria-hidden="true"></span><span id="dash-flow-state">Idle</span></span>
                        </p>
                    </div>
                    <div class="dash-panel-body">
                        <div class="dash-flow" id="dash-flow">
                            <div class="dash-flow-track" aria-hidden="true"></div>
                            <div class="dash-flow-progress" id="workflow-progress-bar" aria-hidden="true"></div>

                            <div class="dash-flow-node" id="node-RECEIVING">
                                <span class="dash-flow-mark" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="M12 3v12m0 0-4-4m4 4 4-4"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg></span>
                                <span class="dash-flow-label">Receiving</span>
                            </div>
                            <div class="dash-flow-node" id="node-RAG_SEARCH">
                                <span class="dash-flow-mark" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4.3-4.3"/></svg></span>
                                <span class="dash-flow-label">Knowledge search</span>
                            </div>
                            <div class="dash-flow-node" id="node-AI_GENERATING">
                                <span class="dash-flow-mark" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="m12 3 1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9Z"/><path d="M18 15.5 18.8 17.4 20.7 18.2 18.8 19 18 21 17.2 19 15.3 18.2 17.2 17.4Z"/></svg></span>
                                <span class="dash-flow-label">AI generating</span>
                            </div>
                            <div class="dash-flow-node" id="node-SENDING">
                                <span class="dash-flow-mark" aria-hidden="true"><svg class="dashboard-icon" viewBox="0 0 24 24"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></span>
                                <span class="dash-flow-label">Sending</span>
                            </div>
                        </div>

                        <dl class="dash-flow-message" id="workflow-message-display" hidden>
                            <dt>User message</dt>
                            <dd id="workflow-user-text"></dd>
                            <div id="workflow-ai-response-container" hidden>
                                <dt>AI response</dt>
                                <dd id="workflow-ai-text"></dd>
                            </div>
                        </dl>
                    </div>
                </section>

                <section class="kw-panel cr-reveal" aria-labelledby="dash-activity-title">
                    <div class="dash-panel-head">
                        <h2 id="dash-activity-title">Recent activity</h2>
                        <a class="kw-btn cr-press" href="conversations.html" data-dashboard-link>
                            View all
                            <span class="kw-pill kw-pill-review" id="dash-waiting-badge" hidden></span>
                            <svg class="dashboard-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                        </a>
                    </div>
                    <div class="dash-panel-body">
                        <table class="dash-activity">
                            <caption class="kw-visually-hidden">Most recent conversations, newest first</caption>
                            <thead>
                                <tr>
                                    <th class="dash-col-time" scope="col">Time</th>
                                    <th class="dash-col-user" scope="col">User</th>
                                    <th class="dash-col-channel" scope="col">Channel</th>
                                    <th class="dash-col-msg" scope="col">Message</th>
                                    <th class="dash-col-status" scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody id="recent-history-body">
                                <tr class="dash-activity-empty">
                                    <td colspan="5">Loading&#8230;</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
        </details>

        <div class="health-warnings" id="bot-health-warnings" role="status"></div>

    </main>

    <Fragment slot="end">
    <script is:inline src="assets/js/index.js"></script>
    </Fragment>
</AppLayout>
