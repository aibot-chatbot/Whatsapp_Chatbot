<!DOCTYPE html>
<html lang="en">
<head>
    <script is:inline src="assets/js/theme-boot.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create account | Omnexa</title>
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <meta name="description" content="Create your Omnexa account and publish to WhatsApp and Telegram from one composer.">
    <meta name="robots" content="noindex,follow">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Geist:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/auth-volleo.css">
    <link rel="stylesheet" href="assets/css/app-preferences.css">
    <script is:inline defer src="assets/js/app-preferences.js"></script>
</head>
<body>
    <div class="auth-shell">
        <main class="auth-main">
            <div class="auth-card">
                <a class="auth-brand" href="landing.html"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 4.2h9.8l-3.1 4H3.9z" fill="currentColor"/><path d="M5.5 10h9.8l-3.1 4H2.4z" fill="currentColor"/><path d="M4 15.8h9.8l-3.1 4H0.9z" fill="currentColor"/></svg> Omnexa</a>

                <div class="auth-head">
                    <h1>Create your Omnexa account</h1>
                    <p>Publish to WhatsApp and Telegram from one composer.</p>
                </div>

                <form id="register-form">
                    <div class="input-group">
                        <label for="first_name">First name</label>
                        <input type="text" id="first_name" placeholder="Marcus" required autocomplete="given-name">
                    </div>

                    <div class="input-group">
                        <label for="last_name">Last name</label>
                        <input type="text" id="last_name" placeholder="Vance" required autocomplete="family-name">
                    </div>

                    <div class="input-group">
                        <label for="company_name">Company name</label>
                        <input type="text" id="company_name" placeholder="Veloce Dynamics" required autocomplete="organization">
                    </div>

                    <div class="input-group">
                        <label for="email">Work email</label>
                        <input type="email" id="email" placeholder="name@company.com" required autocomplete="email" aria-describedby="email-error" oninput="document.getElementById('email-error').style.display='none'">
                        <p id="email-error" class="field-error" role="alert" aria-live="assertive" style="display:none"></p>
                    </div>

                    <div class="input-group">
                        <label for="password">Password</label>
                        <div class="password-field">
                            <input type="password" id="password" placeholder="Create a strong password" required autocomplete="new-password" aria-describedby="strength-text" oninput="checkPasswordStrength(this.value)">
                            <button type="button" class="password-toggle" aria-label="Show password" onclick="togglePasswordVisibility('password', this)">Show</button>
                        </div>
                <div id="password-strength-container" style="display:none">
                    <div class="strength-track">
                        <div id="strength-bar" style="height: 100%; width: 0%; transition: all 0.3s;"></div>
                    </div>
                    <p id="strength-text" class="field-hint" aria-live="polite" aria-atomic="true"></p>
                </div>
                    </div>

                    <div class="input-group">
                        <label for="confirm_password">Confirm password</label>
                        <div class="password-field">
                            <input type="password" id="confirm_password" placeholder="Re-enter your password" required autocomplete="new-password" aria-describedby="password-match-error" oninput="document.getElementById('password-match-error').style.display='none'">
                            <button type="button" class="password-toggle" aria-label="Show password" onclick="togglePasswordVisibility('confirm_password', this)">Show</button>
                        </div>
                        <p id="password-match-error" class="field-error" role="alert" aria-live="assertive" style="display:none">Passwords do not match.</p>
                    </div>

                    <p class="field-hint" style="margin-block:16px">I agree to the <a href="terms.html" target="_blank" rel="noopener">Terms</a> and <a href="privacy.html" target="_blank" rel="noopener">Privacy Policy</a>.</p>

                    <div class="login-error" id="general-error" role="alert" aria-live="assertive" aria-atomic="true"></div>

                    <div class="cf-turnstile"></div>

                    <button type="submit" class="btn-auth" id="submit-btn">
                        <span class="btn-text">Create account</span>
                        <div class="loader"></div>
                    </button>
                </form>

                <div class="auth-divider">OR</div>

                <div class="google-slot">
                    <div id="googleRegisterButton"></div>
                </div>

                <p class="auth-foot">Already have an account? <a href="login.html">Sign in</a></p>
            </div>
        </main>
        <aside class="auth-aside">
            <img class="auth-visual" src="https://manertvcpqtsmegqvhuc.supabase.co/storage/v1/object/public/landing/img/auth-signup.webp" alt="" aria-hidden="true" decoding="async" width="540" height="540">
        </aside>
    </div>

    <!-- Company Name Modal for new Google users -->
    <div class="modal-overlay" id="company-modal" role="dialog" aria-modal="true" aria-labelledby="company-modal-title" aria-describedby="company-modal-desc">
        <div class="modal-box" id="company-modal-box" tabindex="-1">
            <span class="auth-eyebrow">Omnexa account setup</span>
            <h3 id="company-modal-title">One more step</h3>
            <p id="company-modal-desc">Set a password for your Omnexa account so you can also sign in without Google.</p>

            <div class="input-group">
                <label for="modal-company-name">Company</label>
                <input type="text" id="modal-company-name" placeholder="Your Company Sdn Bhd" autocomplete="organization" aria-describedby="google-company-error">
            </div>

            <div class="input-group">
                <label>Password</label>
                <div class="password-field">
                    <input type="password" id="google-company-password" placeholder="Create a password" autocomplete="new-password" aria-label="Password" aria-describedby="google-company-error">
                    <button type="button" class="password-toggle" aria-label="Show password" onclick="togglePasswordVisibility('google-company-password', this)">Show</button>
                </div>
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <div class="password-field">
                    <input type="password" id="google-company-confirm-password" placeholder="Re-enter your password" autocomplete="new-password" aria-label="Confirm password" aria-describedby="google-company-error">
                    <button type="button" class="password-toggle" aria-label="Show password" onclick="togglePasswordVisibility('google-company-confirm-password', this)">Show</button>
                </div>
            </div>

            <p id="google-company-error" class="modal-validation-error" role="alert" aria-live="assertive"></p>

            <button class="btn-confirm" id="btn-confirm-company" onclick="submitGoogleWithCompany()">
                <span class="btn-confirm-text">Create account</span>
                <div class="loader" id="confirm-loader"></div>
            </button>
            <button type="button" class="btn-ghost" style="width:100%;margin-top:10px" onclick="closeCompanyModal()">Cancel</button>
        </div>
    </div>

    <script is:inline src="assets/js/turnstile-guard.js"></script>
    <script is:inline src="assets/js/auth-sentry.js"></script>
    <script is:inline src="assets/js/auth.js"></script>
    <script is:inline src="assets/js/register.js"></script>

    <script is:inline src="https://accounts.google.com/gsi/client" async defer
            onload="handleGoogleLibraryLoad()" onerror="handleGoogleLibraryError()"></script>
</body>
</html>
