---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Bots | Omnexa">
    <Fragment slot="head">
        <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="assets/css/product-tour.css">
        <!-- Not deferred: fetchBots() may finish before deferred scripts run, and it calls omnexaTour.offer(). -->
        <script is:inline src="assets/js/product-tour.js" data-resume="manual"></script>
        <style is:inline>
        :root {
            --canvas: #060A12;
            --panel: #0C1421;
            --raised: #152032;
            --sunken: #04070C;
            --hairline: #1E2A3D;
            --text-main: #F1F5F9;
            --text-dim: #94A3B8;
            --text-tertiary: #75849A;
            --primary: #22D3EE;
            --primary-hover: #38BDF8;
            --accent: #22D3EE;
            /* The teal this palette retired. It was already the de-facto
               connected/healthy colour in the UI, so it keeps that job under a name
               that says so, instead of doubling as the brand accent. Value matches
               the --success auth-volleo.css already defines. */
            --success: #34D399;
            --danger: #F87171;
            --warning: #FBBF24;
            --card-bg: #0C1421;
            --glass-border: #1E2A3D;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: "Geist", sans-serif; }
        body {
            background: var(--canvas);
            background-image: none;
            color: var(--text-main);
            display: block;
            min-height: 100vh;
            overflow-x: hidden;
        }
        body.bots-nav-open { overflow: hidden; }
        .app-shell { min-height: 100vh; display: grid; grid-template-columns: 260px minmax(0, 1fr); }
        .side-rail { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 20px 12px; background: var(--panel); border-right: 1px solid var(--hairline); }
        .rail-brand { padding: 0 12px 22px; font-family: "Space Grotesk", sans-serif; font-size: 18px; font-weight: 700; letter-spacing: -.03em; }
        .rail-label { padding: 8px 12px; color: var(--text-dim); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
        .rail-link { min-height: 40px; display: flex; align-items: center; gap: 11px; padding: 8px 12px; color: var(--text-dim); text-decoration: none; border: 1px solid transparent; border-radius: 8px; font-size: 13px; font-weight: 500; }
        .rail-link:hover { color: var(--text-main); background: var(--raised); }
        .rail-link.active { color: var(--primary-hover); background: rgba(62,156,137,.1); border-color: rgba(62,156,137,.2); }
        .rail-link svg { width: 18px; height: 18px; }
        .rail-account { width: 100%; margin-top: 2px; }
        .rail-account tenant-account-menu { display: block; width: 100%; }
        .rail-spacer { flex: 1; }
        .rail-footer { padding-top: 12px; border-top: 1px solid var(--hairline); }
        .content-shell { min-width: 0; }
        .topbar { min-height: 48px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; border-bottom: 1px solid var(--hairline); }
        .bots-mobile-nav-toggle { display: none; min-height: 36px; align-items: center; gap: 8px; padding: 8px 10px; border: 1px solid var(--hairline); border-radius: 8px; background: var(--panel); color: var(--text-main); cursor: pointer; }
        .bots-mobile-nav-toggle:hover { background: var(--raised); }
        .bots-mobile-nav-toggle svg { width: 17px; height: 17px; }
        .mobile-rail-backdrop { display: none; }
        .topbar-title { color: var(--text-dim); font-family: "JetBrains Mono", monospace; font-size: 12px; }
        .system-status { display: inline-flex; align-items: center; gap: 7px; color: var(--text-dim); font-size: 12px; }
        .system-status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--primary); }
        button, input, textarea, select { font: inherit; }
        a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
            outline: 2px solid var(--primary-hover);
            outline-offset: 2px;
        }
        .main-container {
            max-width: 1440px;
            padding: 38px 48px 64px;
        }
        .header { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 26px; align-items: flex-start; }
        .header h1 {
            font-family: "Space Grotesk", sans-serif;
            font-size: 24px;
            line-height: 1.25;
            letter-spacing: -0.03em;
            background: none;
            -webkit-text-fill-color: currentColor;
        }
        .header p { margin-top: 6px; color: var(--text-dim); font-size: 13px; }
        .workspace-guide { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 0 0 24px; padding: 0; list-style: none; color: var(--text-dim); font-size: 13px; }
        .workspace-guide li { display: flex; align-items: center; gap: 8px; }
        .workspace-guide span { color: var(--primary-hover); font-family: "JetBrains Mono", monospace; font-size: 12px; }
        .header-actions { display: flex; gap: 10px; align-items: center; }
        .create-btn, .cancel-btn, .danger-btn, .action-btn {
            min-height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 8px;
            border: 1px solid var(--hairline);
            box-shadow: none;
            transform: none;
            transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
        }
        .create-btn {
            padding: 10px 16px;
            background: var(--primary);
            color: #08100e;
        }
        .create-btn:hover { background: var(--primary-hover); box-shadow: none; transform: none; }
        .create-btn:disabled { cursor: not-allowed; opacity: .45; }
        .cancel-btn { background: var(--panel); color: var(--text-dim); padding: 10px 14px; }
        .cancel-btn:hover { background: var(--raised); color: var(--text-main); }
        .danger-btn { background: var(--danger); padding: 10px 16px; }
        .danger-btn:hover { background: #b76052; transform: none; box-shadow: none; }
        .danger-btn:disabled { cursor: not-allowed; opacity: .45; }
        .metric-strip {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            border: 1px solid var(--hairline);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 18px;
            background: var(--panel);
        }
        .metric { padding: 15px 18px; border-right: 1px solid var(--hairline); }
        .metric:last-child { border-right: 0; }
        .metric-label { color: var(--text-dim); font-size: 12px; margin-bottom: 7px; }
        .metric-value { font-family: "JetBrains Mono", monospace; font-size: 18px; font-weight: 600; }
        .metric-value.accent { color: var(--primary-hover); }
        .bot-panel { border: 1px solid var(--hairline); border-radius: 10px; background: var(--panel); overflow: hidden; }
        .bot-toolbar {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 16px;
            border-bottom: 1px solid var(--hairline);
            align-items: center;
            flex-wrap: wrap;
        }
        .bot-tabs { display: flex; gap: 4px; }
        .bot-tab {
            min-height: 36px;
            padding: 8px 12px;
            background: transparent;
            border: 1px solid transparent;
            border-radius: 8px;
            color: var(--text-dim);
            cursor: pointer;
            font-weight: 600;
            font-size: 13px;
        }
        .bot-tab[aria-selected="true"] { color: var(--text-main); background: var(--raised); border-color: var(--hairline); }
        .bot-tools { display: flex; align-items: center; gap: 8px; flex: 1; justify-content: flex-end; }
        .search-wrap { position: relative; width: min(320px, 100%); }
        .search-wrap svg { position: absolute; left: 11px; top: 10px; color: var(--text-tertiary); pointer-events: none; }
        .search-input, .status-filter {
            min-height: 38px;
            color: var(--text-main);
            background: var(--sunken);
            border: 1px solid var(--hairline);
            border-radius: 8px;
        }
        .search-input { width: 100%; padding: 9px 12px 9px 36px; }
        .status-filter { padding: 8px 32px 8px 11px; }
        .panel-context {
            min-height: 39px;
            display: flex;
            align-items: center;
            padding: 10px 16px;
            color: var(--text-dim);
            font-size: 12px;
            border-bottom: 1px solid var(--hairline);
        }
        .bot-table-header {
            display: grid;
            grid-template-columns: minmax(260px, 2fr) minmax(160px, 1fr) 120px minmax(210px, auto);
            gap: 18px;
            padding: 10px 18px;
            color: var(--text-tertiary);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            border-bottom: 1px solid var(--hairline);
        }
        .bots-grid { display: block; }
        .glass-card {
            position: relative;
            display: grid;
            grid-template-columns: minmax(260px, 2fr) minmax(160px, 1fr) 120px minmax(210px, auto);
            gap: 18px;
            align-items: center;
            min-height: 82px;
            padding: 14px 18px;
            background: transparent;
            border: 0;
            border-bottom: 1px solid var(--hairline);
            border-radius: 0;
            cursor: pointer;
            box-shadow: none;
        }
        .glass-card:last-child { border-bottom: 0; }
        .glass-card::before { display: none; }
        .glass-card:hover { transform: none; box-shadow: none; background: var(--raised); border-color: var(--hairline); }
        .bot-identity { display: flex; gap: 12px; align-items: center; min-width: 0; }
        .bot-icon { flex: 0 0 auto; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; padding: 0; border-radius: 8px; background: rgba(62,156,137,.13); }
        .bot-copy { min-width: 0; }
        .bot-title { margin: 0 0 4px; font-family: "Space Grotesk", sans-serif; font-size: 15px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .bot-desc { margin: 0; font-size: 12px; line-height: 1.4; -webkit-line-clamp: 1; }
        .bot-meta-container { display: flex; gap: 6px; margin: 0; min-width: 0; }
        .bot-meta { margin: 0; padding: 0; background: transparent; border-radius: 0; font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .bot-meta + .bot-meta::before { content: "·"; margin-right: 6px; color: var(--text-tertiary); }
        .badge { display: inline-block; width: fit-content; padding: 5px 8px; border-radius: 999px; font-size: 11px; }
        .active-badge { color: var(--primary-hover); background: rgba(62,156,137,.12); border-color: rgba(62,156,137,.28); }
        .inactive-badge { background: rgba(138,144,150,.1); border-color: var(--hairline); }
        .bot-actions { display: flex; border: 0; padding: 0; gap: 6px; justify-content: flex-end; }
        .action-btn { flex: 0 0 auto; min-height: 34px; padding: 7px 10px; font-size: 12px; background: transparent; }
        .open-bot-link { color: var(--text-main); text-decoration: none; background: var(--raised); }
        .open-bot-link:hover { border-color: var(--primary); }
        .glass-card { cursor: default; }
        button, a.action-btn { cursor: pointer; }
        .edit-btn, .restore-btn { color: var(--text-main); }
        .edit-btn:hover, .restore-btn:hover { background: var(--raised); border-color: #454b52; }
        .delete-btn, .permanent-delete-btn { color: #d88373; }
        .delete-btn:hover, .permanent-delete-btn:hover { background: rgba(166,86,72,.12); border-color: rgba(166,86,72,.4); }
        .loading-state, .empty-state { min-height: 260px; height: auto; border: 0; border-radius: 0; background: transparent; }
        .loading-state { display: grid; grid-template-columns: 1fr; gap: 1px; padding: 0; }
        .skeleton-row { height: 76px; position: relative; overflow: hidden; border-bottom: 1px solid var(--hairline); }
        .skeleton-row::after { content: ""; position: absolute; inset: 18px; width: 45%; background: var(--raised); border-radius: 6px; animation: pulse 1.1s ease-in-out infinite alternate; }
        @keyframes pulse { to { opacity: .45; } }
        .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 56px 20px; text-align: center; }
        .empty-icon { display: flex; align-items: center; justify-content: center; margin-bottom: 16px; padding: 14px; border-radius: 10px; background: rgba(62,156,137,.1); }
        .empty-state h2 { font-family: "Space Grotesk", sans-serif; font-size: 18px; margin-bottom: 8px; }
        .empty-state p { max-width: 520px; margin-bottom: 22px; font-size: 13px; }
        .modal-overlay { position: fixed; inset: 0; z-index: 999; display: flex; align-items: center; justify-content: center; background: rgba(5,6,7,.82); backdrop-filter: none; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 160ms ease, visibility 160ms ease; }
        .modal-overlay.show { opacity: 1; visibility: visible; pointer-events: auto; }
        .modal-card { width: min(460px, calc(100vw - 32px)); padding: 24px; background: var(--panel); border: 1px solid #3a3f45; border-radius: 10px; box-shadow: none; transform: translateY(8px); }
        .modal-overlay.show .modal-card { transform: none; }
        .modal-card h2 { font-family: "Space Grotesk", sans-serif; font-size: 18px; margin-bottom: 18px; }
        .modal-card label { display: block; margin-top: 16px; margin-bottom: 7px; color: var(--text-dim); font-size: 13px; }
        .modal-card input, .modal-card textarea, .modal-card select { width: 100%; padding: 12px; border: 1px solid var(--hairline); border-radius: 8px; background: var(--sunken); color: var(--text-main); }
        .modal-card input:focus, .modal-card textarea:focus, .modal-card select:focus { box-shadow: 0 0 0 2px rgba(62,156,137,.2); background: var(--sunken); }
        .modal-card textarea { min-height: 100px; resize: vertical; }
        .modal-copy, .field-help { color: var(--text-dim); font-size: 13px; line-height: 1.5; }
        .field-help { display: block; margin-top: 6px; font-size: 12px; }
        .field-error, .form-error { color: #e6a89a; font-size: 13px; line-height: 1.5; margin-top: 8px; }
        .modal-card [aria-invalid="true"] { border-color: var(--danger); }
        #submit-create-btn { min-width: 170px; }
        .modal-card { max-height: calc(100dvh - 32px); overflow-y: auto; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
        .redirect-toast { position: fixed; top: 18px; left: 50%; z-index: 9999; max-width: min(520px, 90vw); padding: 11px 16px; transform: translateX(-50%); border: 1px solid var(--hairline); border-radius: 8px; background: var(--raised); color: var(--text-main); opacity: 0; pointer-events: none; text-align: center; backdrop-filter: none; box-shadow: none; transition: opacity 180ms ease; }
        .redirect-toast.show { opacity: 1; pointer-events: auto; }
        #chatbot-limit-helper { display: none; color: #d88373; font-size: 12px; text-align: right; max-width: 300px; }

        @media (max-width: 900px) {
            .app-shell { grid-template-columns: 76px minmax(0, 1fr); }
            .rail-brand, .rail-label, .rail-link span { display: none; }
            .side-rail { align-items: center; }
            .rail-link { width: 42px; justify-content: center; }
            .rail-account { width: 44px; }
            .main-container { padding: 28px 22px 48px; }
            .header { gap: 18px; }
            .metric-strip { grid-template-columns: repeat(2, 1fr); }
            .metric:nth-child(2) { border-right: 0; }
            .metric:nth-child(-n+2) { border-bottom: 1px solid var(--hairline); }
            .bot-table-header { display: none; }
            .glass-card { grid-template-columns: minmax(0, 1fr) auto; gap: 12px; }
            .bot-identity { grid-column: 1 / -1; }
            .bot-actions { grid-column: 1 / -1; justify-content: flex-start; }
        }
        @media (max-width: 640px) {
            .app-shell { display: block; }
            .side-rail {
                position: fixed;
                z-index: 1201;
                left: 0;
                top: 0;
                width: min(280px, calc(100vw - 32px));
                max-width: calc(100vw - 32px);
                transform: translateX(-105%);
                transition: transform 180ms ease;
                align-items: stretch;
                box-shadow: 22px 0 44px rgba(0,0,0,.38);
            }
            .side-rail.mobile-open { transform: translateX(0); }
            .side-rail .rail-brand,
            .side-rail .rail-label,
            .side-rail .rail-link span { display: block; }
            .side-rail .rail-link { width: 100%; justify-content: flex-start; }
            .side-rail .rail-account { width: 100%; }
            .mobile-rail-backdrop {
                position: fixed;
                inset: 0;
                z-index: 1200;
                background: rgba(5,6,7,.68);
            }
            .mobile-rail-backdrop.show { display: block; }
            .topbar { padding: 0 14px; gap: 10px; }
            .bots-mobile-nav-toggle { display: inline-flex; }
            .main-container { padding: 22px 14px 40px; }
            .header { flex-direction: column; }
            .header-actions { width: 100%; flex-wrap: wrap; }
            .header-actions .create-btn { flex: 1; justify-content: center; }
            .metric-strip { grid-template-columns: 1fr 1fr; }
            .metric { padding: 13px; }
            .bot-toolbar { align-items: stretch; }
            .bot-tabs, .bot-tools { width: 100%; }
            .bot-tab { flex: 1; }
            .bot-tools { flex-wrap: wrap; justify-content: stretch; }
            .search-wrap { width: 100%; }
            .status-filter { flex: 1; }
            .glass-card { padding: 14px; }
            .bot-meta-container { flex-direction: column; gap: 3px; }
            .bot-meta + .bot-meta::before { display: none; }
            .action-btn { flex: 1 1 auto; }
        }
        @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; } }
    </style>
    </Fragment>

    <div id="redirect-toast" class="redirect-toast" role="alert"></div>
    <main class="main-container">
        <div class="header">
            <div>
                <h1>My bots</h1>
                <p>Create a bot, teach it about your business, and choose where customers can use it.</p>
            </div>
            <div class="header-actions">
                <button type="button" class="cancel-btn" onclick="omnexaTour.start()" aria-label="Help: take the product tour"
                    style="display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="circle-help" aria-hidden="true"></i> Help
                </button>
                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;">
                    <button class="create-btn" onclick="openCreateModal()" data-create-bot-trigger="true" disabled title="Checking chatbot limit...">
                        <i data-lucide="plus" aria-hidden="true"></i> New bot
                    </button>
                    <div id="chatbot-limit-helper" role="status"></div>
                </div>
            </div>
        </div>

        <ol class="workspace-guide" aria-label="How to get started">
            <li><span>1</span> Name your bot</li>
            <li><span>2</span> Add a PDF and review its instructions</li>
            <li><span>3</span> Test replies and choose a channel</li>
        </ol>

        <section class="metric-strip" aria-label="Bot overview">
            <div class="metric"><div class="metric-label">Visible bots</div><div class="metric-value" id="visible-bot-count">—</div></div>
            <div class="metric"><div class="metric-label">Plan usage</div><div class="metric-value" id="plan-usage-count">—</div></div>
            <div class="metric"><div class="metric-label">Current view</div><div class="metric-value accent" id="current-view-label">Active</div></div>
            <div class="metric"><div class="metric-label">Connection</div><div class="metric-value accent" id="api-status-label">Checking</div></div>
        </section>

        <section class="bot-panel" aria-label="Bots">
            <div class="bot-toolbar">
                <div class="bot-tabs" role="tablist" aria-label="Bot state">
                    <button id="active-bots-tab" class="bot-tab" role="tab" aria-selected="true" onclick="setBotView('active')">Active</button>
                    <button id="archived-bots-tab" class="bot-tab" role="tab" aria-selected="false" onclick="setBotView('archived')">Archived</button>
                </div>
                <div class="bot-tools">
                    <label class="search-wrap">
                        <span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);">Search bots</span>
                        <i data-lucide="search" aria-hidden="true"></i>
                        <input id="bot-search" class="search-input" type="search" placeholder="Search bots" oninput="renderFilteredBots()">
                    </label>
                    <select id="bot-status-filter" class="status-filter" aria-label="Filter bot status" onchange="renderFilteredBots()">
                        <option value="all">All statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>
            </div>
            <div id="bot-view-message" class="panel-context" aria-live="polite">Active bots can be opened, edited, or archived.</div>
            <div class="bot-table-header" aria-hidden="true">
                <span>Bot</span><span>Configuration</span><span>Status</span><span style="text-align:right;">Actions</span>
            </div>
            <div id="bots-grid" class="bots-grid" aria-live="polite">
                <div class="loading-state" aria-label="Loading bots">
                    <div class="skeleton-row"></div><div class="skeleton-row"></div><div class="skeleton-row"></div>
                </div>
            </div>
        </section>

        <!-- Create/Edit Modal -->
        <div id="create-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="create-modal-title">
            <form id="bot-details-form" class="modal-card" novalidate>
                <h2 id="create-modal-title">Name your bot</h2>
                <p class="modal-copy" id="bot-form-intro">Start with a name. Next, add a PDF for your bot to learn from.</p>

                <label for="bot-name">Bot name <span aria-hidden="true">*</span></label>
                <input id="bot-name" name="bot_name" type="text" required aria-describedby="bot-name-help bot-name-error" placeholder="Example: Customer support">
                <span id="bot-name-help" class="field-help">Use a name you will recognize in your workspace.</span>
                <p id="bot-name-error" class="field-error" hidden>Enter a name for your bot.</p>

                <label for="bot-description">Description (optional)</label>
                <textarea id="bot-description" placeholder="What is this bot for?"></textarea>

                <label for="bot-language">Language</label>
                <input id="bot-language" type="text" value="English">

                <!-- Tone is not edited here. It lives in the bot profile
                     (bot_configs), which is the value the reply pipeline reads.
                     A second tone control on this page wrote a column nothing
                     at runtime consulted. -->

                <div class="modal-actions">
                    <button type="button" class="cancel-btn" onclick="closeCreateModal()">Cancel</button>
                    <button type="submit" id="submit-create-btn" class="create-btn" style="margin: 0;">Create and continue</button>
                </div>
                <p id="bot-form-error" class="form-error" role="alert" hidden></p>
            </form>
        </div>

        <!-- Delete Modal -->
        <div id="delete-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="archive-modal-title">
            <div class="modal-card">
                <h2 id="archive-modal-title">Archive Bot</h2>
                <p style="color: var(--text-dim); line-height: 1.6;">
                    Archive this bot and remove it from active use? Its knowledge files, conversations,
                    messages, channels, CRM records, agent actions, and usage history will be preserved.
                </p>

                <div class="modal-actions">
                    <button class="cancel-btn" onclick="closeDeleteModal()">Cancel</button>
                    <button class="danger-btn" onclick="confirmDeleteBot()">Archive Bot</button>
                </div>
            </div>
        </div>

        <!-- Permanent Delete Modal -->
        <div id="permanent-delete-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="permanent-delete-modal-title">
            <div class="modal-card">
                <h2 id="permanent-delete-modal-title">Permanently Delete Bot</h2>
                <p style="color: var(--danger); line-height: 1.6; font-weight: 600;">
                    This permanently deletes the bot. This cannot be undone.
                </p>
                <p style="color: var(--text-dim); line-height: 1.6;">
                    Related data may be removed, including knowledge files, conversations, messages,
                    channels, CRM records, agent actions, and graph data.
                </p>
                <label for="permanent-delete-confirm-name">Type the exact bot name to confirm</label>
                <input id="permanent-delete-confirm-name" type="text" autocomplete="off" aria-describedby="permanent-delete-helper permanent-delete-error">
                <div id="permanent-delete-helper" style="color:var(--text-dim);font-size:0.85rem;margin-top:-4px;margin-bottom:12px;"></div>
                <div id="permanent-delete-error" style="display:none;color:var(--danger);font-size:0.85rem;margin-top:-8px;margin-bottom:12px;">
                    Type the exact bot name to permanently delete this bot.
                </div>

                <div class="modal-actions">
                    <button class="cancel-btn" onclick="closePermanentDeleteModal()">Cancel</button>
                    <button id="permanent-delete-confirm-btn" class="danger-btn" onclick="confirmPermanentDeleteBot()" disabled>Permanently Delete</button>
                </div>
            </div>
        </div>
    </main>

    <Fragment slot="end">
        <script is:inline src="assets/js/bots.js"></script>
    </Fragment>
</AppLayout>
