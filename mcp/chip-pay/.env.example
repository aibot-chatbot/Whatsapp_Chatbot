# CHIP Pay MCP server configuration.
# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# --- CHIP Collect (accept payments) --- REQUIRED ---------------------------
# Portal > Developers > API Keys:  https://portal.chip-in.asia/collect/developers/api-keys
CHIP_COLLECT_SECRET_KEY=

# Optional. Portal > Developers > Brands. When set, it is filled in
# automatically for any call that needs a brand_id and does not supply one.
CHIP_BRAND_ID=

# --- CHIP Send (payouts) --- OPTIONAL --------------------------------------
# Separate credentials from Collect. Send tools only appear when BOTH are set.
# The secret is never transmitted; it signs the per-request checksum.
CHIP_SEND_API_KEY=
CHIP_SEND_API_SECRET=
# Use the CHIP Send sandbox (staging-api.chip-in.asia) instead of production.
CHIP_SEND_STAGING=false

# --- Safety ----------------------------------------------------------------
# Refunds, captures, charges, releases, mark-as-paid and payouts are refused
# unless this is true. Leave false until you actually intend to move money.
CHIP_ALLOW_MONEY_MOVEMENT=false

# --- Tuning ----------------------------------------------------------------
# curated = the high-value tools (default). all = every one of the 58 operations.
# chip_request reaches every operation regardless of this setting.
CHIP_TOOLS=curated
CHIP_TIMEOUT_SECONDS=30
CHIP_MAX_RESPONSE_CHARS=20000

# Override only for a proxy or a CHIP-provided alternate host.
# CHIP_COLLECT_BASE_URL=https://gate.chip-in.asia/api/v1
# CHIP_SEND_BASE_URL=https://api.chip-in.asia/api
