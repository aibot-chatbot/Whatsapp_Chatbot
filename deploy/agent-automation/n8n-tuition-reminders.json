{
  "name": "Tuition reminder tick (Telegram consent required)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "analysis-schedule-clock",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://REPLACE_APPROVED_FLASK_HOST/internal/tuition-reminders/tick",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "analysis-schedule-enqueue",
      "name": "Enqueue due trial reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_CREDENTIAL_ID",
          "name": "Analysis internal bearer"
        }
      },
      "notes": "Authorization credential stays encrypted. Enable only after migrations 066/067, Telegram identity, per-booking consent, shared Flask send lock and uncertain-result recovery are verified. Tick only enqueues; provider acceptance is recorded by the fenced Flask sender."
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Enqueue due trial reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kuala_Lumpur",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "pinData": {}
}